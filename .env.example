# Copy to .env.local and tweak.

# --- API ---
NODE_ENV=development
PORT=3001
PUBLIC_APP_URL=http://localhost:3000

# Connection goes through PgBouncer; PG itself is exposed on 5432 for tools.
CONTROL_DATABASE_URL=postgresql://libriant:libriant@localhost:6432/libriant_control
REDIS_URL=redis://localhost:6379

# Where per-tenant files live. In prod this is the Storage Box mount.
STORAGE_ROOT=./.dev-storage

# Optional override. When unset, the app reads /assets from the repo root —
# which is exactly the hot-swap behaviour designers need locally.
# ASSETS_ROOT=/srv/libriant/assets

# Optional override for the translations folder, same pattern as ASSETS_ROOT.
# LOCALES_ROOT=/srv/libriant/locales

# --- Tenancy ---
# Apex domain used to detect a tenant from the Host header subdomain.
# Use "localhost" in dev — then `Host: acme.localhost` maps to slug=acme.
PUBLIC_APEX_DOMAIN=localhost
# URL prefix that signals a tenant-scoped request. Leave at the default
# unless you have a reason to remap.
TENANT_PATH_PREFIX=/t/
# How long (in seconds) the slug → tenant context Redis cache lasts.
TENANT_CACHE_TTL_SEC=300
# How many per-tenant Prisma clients stay hot in memory before LRU eviction.
TENANT_CLIENT_CACHE_SIZE=50
# Idle TTL (ms) before an unused tenant client is evicted + disconnected.
TENANT_CLIENT_IDLE_MS=1800000

# --- Auth / sessions ---
# HMAC secret for session JWTs. MUST be a long random string in non-dev.
SESSION_SECRET=dev-only-session-secret-CHANGE-IN-PROD
# Session lifetime in seconds (default 7 days).
SESSION_TTL_SEC=604800
# Set "true" if serving over HTTPS — switches the cookie to __Host- prefix
# and Secure flag. "auto" infers from PUBLIC_APP_URL scheme.
SESSION_COOKIE_SECURE=auto
# bcrypt cost. 12 ≈ 250ms per hash on modern hardware. Tuneable.
BCRYPT_COST=12
# Failed logins before lockout, and lockout duration (ms). 5 attempts / 15 min.
MAX_FAILED_LOGINS=5
LOGIN_LOCKOUT_MS=900000

# Postgres connection used by signup to CREATE DATABASE for new tenants.
# In dev this is the libriant superuser. In prod, a dedicated provisioning
# role per cell.
PG_SUPERUSER_URL=postgresql://libriant:libriant@localhost:5432/libriant_control

# --- Storage ---
# HMAC secret for signed download URLs. Defaults to SESSION_SECRET in dev.
# STORAGE_SIGNING_SECRET=
# How long (seconds) signed download URLs stay valid by default.
STORAGE_SIGNED_TTL_SEC=3600
# Hard ceiling on a single uploaded file (bytes). Per-plan max_storage_mb
# limits the total per tenant.
STORAGE_MAX_UPLOAD_BYTES=26214400
