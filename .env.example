# Copy to .env.local and tweak.

# --- API ---
NODE_ENV=development
PORT=3001
PUBLIC_APP_URL=http://localhost:3000

# Connection goes through PgBouncer; PG itself is exposed on 5432 for tools.
CONTROL_DATABASE_URL=postgresql://libriant:libriant@localhost:6432/libriant_control
REDIS_URL=redis://localhost:6379

# Where per-tenant files live. In prod this is the Storage Box mount.
STORAGE_ROOT=./.dev-storage

# Optional override. When unset, the app reads /assets from the repo root —
# which is exactly the hot-swap behaviour designers need locally.
# ASSETS_ROOT=/srv/libriant/assets

# Optional override for the translations folder, same pattern as ASSETS_ROOT.
# LOCALES_ROOT=/srv/libriant/locales

# --- Tenancy ---
# Apex domain used to detect a tenant from the Host header subdomain.
# Use "localhost" in dev — then `Host: acme.localhost` maps to slug=acme.
PUBLIC_APEX_DOMAIN=localhost
# URL prefix that signals a tenant-scoped request. Leave at the default
# unless you have a reason to remap.
TENANT_PATH_PREFIX=/t/
# How long (in seconds) the slug → tenant context Redis cache lasts.
TENANT_CACHE_TTL_SEC=300
# How many per-tenant Prisma clients stay hot in memory before LRU eviction.
TENANT_CLIENT_CACHE_SIZE=50
# Idle TTL (ms) before an unused tenant client is evicted + disconnected.
TENANT_CLIENT_IDLE_MS=1800000
