# Libriant — Caddy edge config.
#
# Two hosts (today): the public apex and the admin host. Both terminate TLS
# via Caddy's built-in ACME. Custom-subdomain tenants (a Pro/Enterprise
# feature) need a wildcard certificate; see the commented block at the
# bottom for the switch.
#
# Routing model:
#   /lbr-api/*  →  api:3001            (strip prefix; same-origin to web)
#   /_assets/*  →  /srv/libriant/assets/  (static; immutable + ETag)
#   /*          →  web:3000             (Next.js)
#
# The `MAINTENANCE_HARD` env var is the belt-and-braces edge fallback. When
# set to "true", Caddy serves the static page from disk *without* touching
# upstream — even if api + web are down. SystemModeMiddleware on the API
# also surfaces a takeover, but this one survives a full app outage.
{
	# Defaults applied to every site block below. ACME issuance uses
	# Caddy's built-in HTTP-01 / TLS-ALPN-01 challenges; for the wildcard
	# block, override to a DNS provider plugin.
	email {$ACME_EMAIL:ops@libriant.com}

	# Structured access log. Compose mounts this to a host volume so the
	# nightly job can rotate it.
	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 14
		}
		format json
	}

	# Disable the admin endpoint in prod — we don't shell into Caddy.
	admin off
}

# ---- Common snippet: security headers + the maintenance-takeover fallback ----

(security_headers) {
	header {
		# Force HTTPS for a year, opt subdomains in so the wildcard works
		# once it's enabled.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Generic hardening — these match the defaults Next.js wants.
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Caddy adds its own Server header; strip it.
		-Server
	}
}

(site_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# The marketing site ships zero JavaScript and fetches nothing from
		# anywhere, so it can afford a CSP the app cannot. `security_headers`
		# carries no CSP at all, which is why this is a separate snippet rather
		# than an import of it — reusing that one would silently drop
		# form-action, frame-ancestors and base-uri on the page that carries the
		# application form.
		# 'unsafe-inline' in style-src is required: pages.ts emits two style
		# attributes. script-src stays 'none'.
		Content-Security-Policy "default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
}

(maintenance_check) {
	# When the orchestrator flips $MAINTENANCE_HARD=true on the host, every
	# request below returns the static page directly. We use a `try_files`
	# style match so /healthz still passes through (load balancer checks
	# need this to keep working).
	@is_probe path /healthz /readyz /metrics
	handle @is_probe {
		respond "ok" 200
	}
}

(static_assets) {
	# Themable assets live in the shared bind-mount. Caddy serves them
	# without touching upstream, with ETag + Last-Modified handled
	# automatically by file_server.
	handle_path /_assets/* {
		root * /srv/libriant/assets
		file_server {
			precompressed gzip
		}
		header Cache-Control "public, max-age=300"
	}
}

(maintenance_takeover) {
	# Mode-of-last-resort: $MAINTENANCE_HARD=true ⇒ serve the static page
	# for every browser request, regardless of upstream health.
	@hard_maint vars {$MAINTENANCE_HARD:false} "true"
	handle @hard_maint {
		root * /srv/libriant/caddy
		rewrite * /maintenance.html
		file_server
		header Cache-Control "no-store"
		header X-Maintenance "hard"
	}
}

(cloudflare_origin) {
	# We run BEHIND Cloudflare's proxy (orange-cloud). Cloudflare terminates
	# the public TLS, so Caddy can't complete a Let's Encrypt ACME challenge
	# (the challenge never reaches the origin). Instead Caddy serves a
	# Cloudflare **Origin Certificate** (15-year, trusted by Cloudflare), and
	# Cloudflare's SSL/TLS mode is set to **Full (strict)** so the edge
	# validates it. Generate the cert in the Cloudflare dashboard
	# (SSL/TLS → Origin Server → Create Certificate; hosts: libriant.com,
	# *.libriant.com) and place it on the host — see the compose mount.
	tls /etc/caddy/origin/origin.crt /etc/caddy/origin/origin.key
}

(origin_guard) {
	# Admit only a Cloudflare (or on-host) TCP peer, and then decide — from that
	# peer, never from a header — who the client is. Was `(cloudflare_only)`;
	# renamed because it now does BOTH halves, and the two must never be
	# separated again. Takes one argument: a tag unique within the site block
	# (`import origin_guard lbrapi`), because named matchers are scoped to the
	# whole site block and a snippet imported twice would redefine them.
	#
	# THE RULE: every route that proxies to api:3001 or web:3000 imports this,
	# first, inside a `route` (only `route` honours source order). Caddy serving a
	# static file keys nothing on the client IP and does not need it. The
	# /webhooks/* route on the app host is what happens when the rule is applied
	# by memory instead of by rule — it was left unguarded in the first pass, so
	# direct-to-origin traffic reached the API and its own X-Real-IP header was
	# forwarded verbatim.
	#
	# --- what this closes ------------------------------------------------------
	# authn-authz-01 / input-and-files-02 / input-and-files-03: `header_up
	# X-Real-IP {http.request.header.CF-Connecting-IP}` used to run for EVERY
	# peer, so anyone who could reach the origin directly chose their own value
	# for the header that every rate limit, the login lockout and the signup
	# admission gate key on. 25 logins with a rotating header never tripped the
	# 20/5min cap; eight signups with a rotating header provisioned eight Postgres
	# databases.
	#
	# The first fix admitted only Cloudflare + private peers, and a verifier
	# walked straight through it over IPv6: the host has a public v6 address
	# (2a01:4f8:13b:ac8::2), Docker publishes 443 on [::] as well as 0.0.0.0, and
	# no compose network sets `enable_ipv6` — so a v6 connection is carried to the
	# container by Docker's USERLAND PROXY, which opens a fresh v4 connection from
	# the BRIDGE GATEWAY. `remote_ip` then sees a private address, `private_ranges`
	# admits it, and the forged CF-Connecting-IP was stamped into X-Real-IP as
	# before. 25 rotating headers, 25 buckets, again.
	#
	# So the peer decides the identity, and only a real Cloudflare peer is allowed
	# to name someone else:
	#   • peer in a Cloudflare range → CF-Connecting-IP is authoritative;
	#   • any other admitted peer (on-host curl, the Docker userland proxy) → the
	#     peer address IS the identity, and its CF-Connecting-IP is deleted.
	# The worst an attacker on the v6/userland path can now do is share ONE bucket
	# (the gateway) with every other such caller — a bounded, self-inflicted
	# limit, not an unbounded supply of fresh buckets.
	#
	# X-Forwarded-For is dropped on the way in for the same reason: whatever the
	# client wrote there is not evidence. reverse_proxy re-adds it with the true
	# peer, so the upstream sees exactly one entry, one we vouch for.
	#
	# --- what this does NOT close ---------------------------------------------
	# Any Cloudflare customer can point a Worker at our origin IP, so "peer is in
	# a Cloudflare range" is not "peer is OUR zone". Closing that needs a secret
	# only our zone can add — see the commented `@no_origin_secret` block below —
	# or Authenticated Origin Pulls with a CUSTOM certificate. Until then this
	# layer is worth exactly one thing: the attacker must go through Cloudflare,
	# where they are rate-limited, logged and blockable. The host firewall
	# (scripts/prod-bootstrap.sh --firewall-only) is the layer that makes that
	# mandatory; this one is what keeps working if the firewall is flushed.
	#
	# The list is Cloudflare's published ranges (https://www.cloudflare.com/ips).
	# It changes rarely, but it DOES change: if legitimate traffic starts getting
	# 403s at the edge, re-check it against that URL before anything else. It
	# appears TWICE below and once in `scripts/prod-bootstrap.sh` — update all
	# three together.
	@untrusted_peer_{args[0]} not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 private_ranges
	respond @untrusted_peer_{args[0]} 403

	@cf_peer_{args[0]} remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	# Only reachable for a peer the guard above already admitted, so "not
	# Cloudflare" here means "on-host or the Docker userland proxy".
	@local_peer_{args[0]} remote_ip private_ranges

	request_header -X-Forwarded-For
	request_header @cf_peer_{args[0]} X-Real-IP {http.request.header.CF-Connecting-IP}
	request_header @local_peer_{args[0]} X-Real-IP {remote_host}
	request_header @local_peer_{args[0]} -CF-Connecting-IP

	# NOT YET ENABLED — the closure for "any Cloudflare customer can reach us".
	# Add a Transform Rule on the zone (Rules → Transform → Modify Request
	# Header) that sets `X-Origin-Secret` to the value of $ORIGIN_SHARED_SECRET,
	# put that secret in /srv/libriant/.env.prod, THEN uncomment these two lines
	# and reload. Order matters: uncommenting first takes the whole site down.
	# @no_origin_secret_{args[0]} not header X-Origin-Secret {$ORIGIN_SHARED_SECRET:unset}
	# respond @no_origin_secret_{args[0]} 403
}

# ---------------------------------------------------------------------------
# Plaintext HTTP (:80) — health probes + redirect everything else to HTTPS.
#
# Container/host health checks hit `http://localhost/healthz` and must get a
# 200 directly. Without this explicit block, Caddy's automatic HTTP→HTTPS
# redirect sends the probe to `https://localhost`, whose SNI has no certificate
# (we only hold the libriant.com origin cert) → the probe fails and Caddy
# reports "unhealthy" even though it is serving fine. Carving the probe out on
# :80 also keeps it reachable for an on-host deploy health check that bypasses
# Cloudflare (whose managed challenge 403s automated requests).
# ---------------------------------------------------------------------------

http:// {
	@probe path /healthz /readyz
	handle @probe {
		respond "ok" 200
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

# ---------------------------------------------------------------------------
# Public apex — libriant.com
# ---------------------------------------------------------------------------

{$PUBLIC_HOST:app.libriant.com} {
	import security_headers
	import maintenance_check
	import maintenance_takeover
	import static_assets
	import cloudflare_origin

	# API requests routed by the browser go through /lbr-api/* (same-origin)
	# to avoid SameSite + CORS pain on the session cookie. Strip the prefix
	# before forwarding so the API sees its native routes (/auth/me etc).
	handle_path /lbr-api/* {
		# `route` so source order is honoured: the internal-ops block is
		# evaluated BEFORE the catch-all reverse_proxy. The prefix is already
		# stripped here, so these match /lbr-api/metrics, /lbr-api/healthz, …
		route {
			# Nothing reaches the API unless the TCP peer is Cloudflare or the
			# host itself, and the X-Real-IP that every rate limit keys on is
			# written HERE, from that peer — never taken from the client.
			import origin_guard lbrapi
			# /metrics, /healthz, /readyz carry fleet-wide operational intel
			# (tenant counts, capacity + queue gauges, readiness internals).
			# Prometheus scrapes api:3001 DIRECTLY on the private monitoring
			# network — nothing legitimate reaches them through the public
			# proxy, so 404 them at the edge.
			@internal path /metrics /metrics/* /healthz /readyz
			respond @internal 404
			# X-Real-IP is set by `origin_guard` above, deliberately NOT by a
			# `header_up` here: header_up runs for every peer, which is exactly
			# how the forged-CF-Connecting-IP bug worked. The guard's version is
			# conditional on who the peer actually is. The API applies its own
			# peer check on top (apps/api/src/platform/client-ip.ts).
			reverse_proxy api:3001 {
				# A failed upstream should look like a 503, not a 502.
				fail_duration 10s
				max_fails 3
			}
		}
	}

	# Webhook surface — Stripe + future providers. Same upstream as the
	# API, no prefix stripping needed (the controller lives at the same
	# /webhooks path on the API).
	#
	# This route was left unguarded in the first pass at authn-authz-01, which is
	# why `origin_guard` now states the rule in its own comment instead of
	# leaving it to memory: it was a straight path to api:3001 for anyone who
	# could reach the origin, and because nothing rewrote the headers the API
	# received the CLIENT'S OWN X-Real-IP verbatim and believed it — the peer was
	# Caddy, so it was trusted. Stripe reaches us through Cloudflare like
	# everything else; a webhook that 403s at the edge means the sender did not.
	handle /webhooks/* {
		route {
			import origin_guard webhooks
			reverse_proxy api:3001
		}
	}

	# Everything else → Next.js. Guarded too. This host only ever works behind
	# Cloudflare (it presents an Origin CA certificate no browser trusts), so
	# nothing legitimate arrives direct-to-origin, and guarding EVERY proxied
	# path rather than the ones we remember is what stops the next /webhooks.
	handle {
		route {
			import origin_guard appweb
			reverse_proxy web:3000
		}
	}
}

# ---------------------------------------------------------------------------
# Admin host — admin.libriant.com
#
# Same backend; we just want a different cookie scope + a host an operator
# can bookmark. Admin login lives at /admin/login on the web app.
# ---------------------------------------------------------------------------

{$ADMIN_HOST:admin.libriant.com} {
	import security_headers
	import maintenance_check
	import maintenance_takeover
	import static_assets
	import cloudflare_origin

	handle_path /lbr-api/* {
		route {
			# This host carries the admin login, whose brute-force lockout keys on
			# the client IP (authn-authz-03) — origin traffic must not reach it.
			import origin_guard adminapi
			# Internal ops endpoints are scraped on the private network only —
			# never expose them through the public admin proxy. See public host.
			@internal path /metrics /metrics/* /healthz /readyz
			respond @internal 404
			# X-Real-IP comes from origin_guard, not from a header_up. See the
			# app host above for why that distinction is the whole fix.
			reverse_proxy api:3001
		}
	}

	# Redirect bare visits straight into the admin login, then proxy
	# everything else to the web app.
	#
	# This is wrapped in `route` ON PURPOSE: a standalone `handle @bare`
	# alongside the other handle/handle_path blocks above gets bypassed —
	# the catch-all `handle { reverse_proxy }` wins for "/", so the bare host
	# root rendered blank. `route` evaluates its directives in source order,
	# so the "/" redirect is matched before the catch-all proxy.
	@bare path /
	route {
		# The admin console itself, not just its API: this host is the one an
		# attacker would want to reach directly.
		import origin_guard adminweb
		redir @bare /admin/login 302
		reverse_proxy web:3000
	}
}

# ---------------------------------------------------------------------------
# Marketing site — libriant.com
#
# Static files, baked into this image at build time (infra/caddy/Dockerfile).
# It is served here rather than by the app so that it stays up when the app does
# not: an outage should still leave a readable page and a working form.
#
# The ONLY thing proxied to the API is the application form. Do not add a
# handle_path /lbr-api/* block here — the @internal guard that 404s /metrics and
# /healthz is written once per vhost above, and a third vhost proxying to
# api:3001 without it would re-expose fleet-wide tenant counts at
# libriant.com/lbr-api/metrics.
# ---------------------------------------------------------------------------

{$SITE_HOST:libriant.com} {
	# REQUIRED. Without the origin certificate Caddy attempts an ACME challenge
	# that can never complete behind Cloudflare's proxy, and the visitor gets a
	# 526.
	import cloudflare_origin
	import site_headers
	# Keeps https://libriant.com/healthz answering for existing uptime monitors.
	import maintenance_check
	# Deliberately NOT maintenance_takeover: the marketing site is precisely the
	# page that has to stay readable while the app is in maintenance.

	encode zstd gzip
	root * /srv/libriant/site

	# ---- the application form ------------------------------------------------
	# Same-origin on purpose: no CORS, no SameSite question, the 303 lands on the
	# site's own /thank-you, and the API's origin check passes because
	# PUBLIC_APEX_DOMAIN is still libriant.com.
	@apply path /apply /en/apply
	handle @apply {
		# `route`, not a bare reverse_proxy: the origin guard has to be evaluated
		# before the proxy, and only route honours source order.
		route {
			# Writes the X-Real-IP the form's 5/hour throttle keys on, from the
			# TCP peer. The static handlers below are deliberately NOT guarded:
			# they key nothing on the client and they are the pages that must stay
			# readable when everything else is down. Anything reaching api:3001 is.
			import origin_guard apply
			reverse_proxy api:3001 {
				fail_duration 10s
				max_fails 3
			}
		}
	}

	# ---- links to app paths that used to live on this host -------------------
	# Password-reset and verification emails already sitting in inboxes were
	# built against this origin. Preserve path AND query so live tokens work.
	@moved path /login /login/* /signup /signup/* /verify-email /verify-email/* /t/* /el/legal/* /en/legal/* /offline.html
	redir @moved https://{$PUBLIC_HOST:app.libriant.com}{uri} 302
	redir /admin https://{$ADMIN_HOST:admin.libriant.com}/admin/login 302
	redir /admin/* https://{$ADMIN_HOST:admin.libriant.com}{uri} 302

	# ---- static assets -------------------------------------------------------
	# Filenames are not fingerprinted, so a short TTL plus the ETag rather than a
	# long immutable one — otherwise a copy fix takes a year to reach a visitor.
	@site_assets path /styles.css /favicon.svg /icons/* /sw.js
	handle @site_assets {
		header Cache-Control "public, max-age=300"
		file_server
	}

	handle {
		header Cache-Control "public, max-age=0, must-revalidate"
		# Pretty URLs: pages link to /pricing and /en/pricing, backed by the flat
		# files pricing.html and en/pricing.html. `/` and `/en/` are directories.
		try_files {path} {path}.html
		file_server
	}

	handle_errors {
		root * /srv/libriant/site
		@nf_en expression `{err.status_code} == 404 && {http.request.orig_uri.path}.startsWith("/en/")`
		handle @nf_en {
			rewrite * /en/404.html
			file_server {
				status 404
			}
		}
		@nf expression `{err.status_code} == 404`
		handle @nf {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		handle {
			respond "{err.status_code} {err.status_text}"
		}
	}
}

www.{$SITE_HOST:libriant.com} {
	import cloudflare_origin
	redir https://{$SITE_HOST:libriant.com}{uri} permanent
}

