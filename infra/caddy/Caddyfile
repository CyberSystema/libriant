# Libriant — Caddy edge config.
#
# Two hosts (today): the public apex and the admin host. Both terminate TLS
# via Caddy's built-in ACME. Custom-subdomain tenants (a Pro/Enterprise
# feature) need a wildcard certificate; see the commented block at the
# bottom for the switch.
#
# Routing model:
#   /lbr-api/*  →  api:3001            (strip prefix; same-origin to web)
#   /_assets/*  →  /srv/libriant/assets/  (static; immutable + ETag)
#   /*          →  web:3000             (Next.js)
#
# The `MAINTENANCE_HARD` env var is the belt-and-braces edge fallback. When
# set to "true", Caddy serves the static page from disk *without* touching
# upstream — even if api + web are down. SystemModeMiddleware on the API
# also surfaces a takeover, but this one survives a full app outage.
{
	# Defaults applied to every site block below. ACME issuance uses
	# Caddy's built-in HTTP-01 / TLS-ALPN-01 challenges; for the wildcard
	# block, override to a DNS provider plugin.
	email {$ACME_EMAIL:ops@libriant.com}

	# Structured access log. Compose mounts this to a host volume so the
	# nightly job can rotate it.
	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 14
		}
		format json
	}

	# Disable the admin endpoint in prod — we don't shell into Caddy.
	admin off
}

# ---- Common snippet: security headers + the maintenance-takeover fallback ----

(security_headers) {
	header {
		# Force HTTPS for a year, opt subdomains in so the wildcard works
		# once it's enabled.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Generic hardening — these match the defaults Next.js wants.
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Caddy adds its own Server header; strip it.
		-Server
	}
}

(maintenance_check) {
	# When the orchestrator flips $MAINTENANCE_HARD=true on the host, every
	# request below returns the static page directly. We use a `try_files`
	# style match so /healthz still passes through (load balancer checks
	# need this to keep working).
	@is_probe path /healthz /readyz /metrics
	handle @is_probe {
		respond "ok" 200
	}
}

(static_assets) {
	# Themable assets live in the shared bind-mount. Caddy serves them
	# without touching upstream, with ETag + Last-Modified handled
	# automatically by file_server.
	handle_path /_assets/* {
		root * /srv/libriant/assets
		file_server {
			precompressed gzip
		}
		header Cache-Control "public, max-age=300"
	}
}

(maintenance_takeover) {
	# Mode-of-last-resort: $MAINTENANCE_HARD=true ⇒ serve the static page
	# for every browser request, regardless of upstream health.
	@hard_maint vars {$MAINTENANCE_HARD:false} "true"
	handle @hard_maint {
		root * /srv/libriant/caddy
		rewrite * /maintenance.html
		file_server
		header Cache-Control "no-store"
		header X-Maintenance "hard"
	}
}

(cloudflare_origin) {
	# We run BEHIND Cloudflare's proxy (orange-cloud). Cloudflare terminates
	# the public TLS, so Caddy can't complete a Let's Encrypt ACME challenge
	# (the challenge never reaches the origin). Instead Caddy serves a
	# Cloudflare **Origin Certificate** (15-year, trusted by Cloudflare), and
	# Cloudflare's SSL/TLS mode is set to **Full (strict)** so the edge
	# validates it. Generate the cert in the Cloudflare dashboard
	# (SSL/TLS → Origin Server → Create Certificate; hosts: libriant.com,
	# *.libriant.com) and place it on the host — see the compose mount.
	tls /etc/caddy/origin/origin.crt /etc/caddy/origin/origin.key
}

# ---------------------------------------------------------------------------
# Plaintext HTTP (:80) — health probes + redirect everything else to HTTPS.
#
# Container/host health checks hit `http://localhost/healthz` and must get a
# 200 directly. Without this explicit block, Caddy's automatic HTTP→HTTPS
# redirect sends the probe to `https://localhost`, whose SNI has no certificate
# (we only hold the libriant.com origin cert) → the probe fails and Caddy
# reports "unhealthy" even though it is serving fine. Carving the probe out on
# :80 also keeps it reachable for an on-host deploy health check that bypasses
# Cloudflare (whose managed challenge 403s automated requests).
# ---------------------------------------------------------------------------

http:// {
	@probe path /healthz /readyz
	handle @probe {
		respond "ok" 200
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

# ---------------------------------------------------------------------------
# Public apex — libriant.com
# ---------------------------------------------------------------------------

{$PUBLIC_HOST:libriant.com} {
	import security_headers
	import maintenance_check
	import maintenance_takeover
	import static_assets
	import cloudflare_origin

	# API requests routed by the browser go through /lbr-api/* (same-origin)
	# to avoid SameSite + CORS pain on the session cookie. Strip the prefix
	# before forwarding so the API sees its native routes (/auth/me etc).
	handle_path /lbr-api/* {
		# `route` so source order is honoured: the internal-ops block is
		# evaluated BEFORE the catch-all reverse_proxy. The prefix is already
		# stripped here, so these match /lbr-api/metrics, /lbr-api/healthz, …
		route {
			# /metrics, /healthz, /readyz carry fleet-wide operational intel
			# (tenant counts, capacity + queue gauges, readiness internals).
			# Prometheus scrapes api:3001 DIRECTLY on the private monitoring
			# network — nothing legitimate reaches them through the public
			# proxy, so 404 them at the edge.
			@internal path /metrics /metrics/* /healthz /readyz
			respond @internal 404
			reverse_proxy api:3001 {
				# Pass the REAL client IP so audit logs + rate limits key off it.
				# Behind Cloudflare the true client is in `CF-Connecting-IP`
				# (the TCP peer {remote_host} is a Cloudflare edge node). The host
				# firewall only admits Cloudflare's ranges, so the header can't be
				# spoofed by hitting the origin directly.
				header_up X-Real-IP {http.request.header.CF-Connecting-IP}
				# A failed upstream should look like a 503, not a 502.
				fail_duration 10s
				max_fails 3
			}
		}
	}

	# Webhook surface — Stripe + future providers. Same upstream as the
	# API, no prefix stripping needed (the controller lives at the same
	# /webhooks path on the API).
	handle /webhooks/* {
		reverse_proxy api:3001
	}

	# Everything else → Next.js.
	handle {
		reverse_proxy web:3000
	}
}

# ---------------------------------------------------------------------------
# Admin host — admin.libriant.com
#
# Same backend; we just want a different cookie scope + a host an operator
# can bookmark. Admin login lives at /admin/login on the web app.
# ---------------------------------------------------------------------------

{$ADMIN_HOST:admin.libriant.com} {
	import security_headers
	import maintenance_check
	import maintenance_takeover
	import static_assets
	import cloudflare_origin

	handle_path /lbr-api/* {
		route {
			# Internal ops endpoints are scraped on the private network only —
			# never expose them through the public admin proxy. See public host.
			@internal path /metrics /metrics/* /healthz /readyz
			respond @internal 404
			reverse_proxy api:3001 {
				header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			}
		}
	}

	# Redirect bare visits straight into the admin login, then proxy
	# everything else to the web app.
	#
	# This is wrapped in `route` ON PURPOSE: a standalone `handle @bare`
	# alongside the other handle/handle_path blocks above gets bypassed —
	# the catch-all `handle { reverse_proxy }` wins for "/", so the bare host
	# root rendered blank. `route` evaluates its directives in source order,
	# so the "/" redirect is matched before the catch-all proxy.
	@bare path /
	route {
		redir @bare /admin/login 302
		reverse_proxy web:3000
	}
}

