{
  "$schema": "../manifest.schema.json",
  "name": "libriant-default",
  "version": "0.1.0",
  "colors": {
    "primary": "#1f6feb",
    "primary-hover": "#1858c9",
    "primary-fg": "#ffffff",
    "accent": "#8957e5",
    "danger": "#cf222e",
    "danger-hover": "#a40e26",
    "warning": "#bf8700",
    "success": "#1a7f37",
    "info": "#0969da",
    "surface": "#ffffff",
    "surface-raised": "#ffffff",
    "surface-muted": "#f6f8fa",
    "surface-sunken": "#eaeef2",
    "border": "#d0d7de",
    "border-muted": "#eaeef2",
    "text": "#0d1117",
    "text-muted": "#57606a",
    "text-subtle": "#6e7781",
    "text-on-primary": "#ffffff",
    "focus-ring": "#0969da"
  },
  "fonts": {
    "sans": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "serif": "'Source Serif Pro', Georgia, serif",
    "mono": "'JetBrains Mono', 'SF Mono', Consolas, monospace"
  },
  "fontSizes": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "base": "1rem",
    "lg": "1.125rem",
    "xl": "1.25rem",
    "2xl": "1.5rem",
    "3xl": "2rem",
    "4xl": "2.5rem"
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem"
  },
  "radius": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0,0,0,0.05)",
    "md": "0 4px 8px rgba(0,0,0,0.08)",
    "lg": "0 12px 24px rgba(0,0,0,0.12)"
  }
}
