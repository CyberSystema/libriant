{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // DOM, not node. `TextDecoder`, `TextEncoder`, `Uint8Array` and
    // `crypto.subtle` are all here; `Buffer`, `process` and every `node:`
    // specifier are not, so the phase's "runs unchanged in a webview and in the
    // Tauri client" is enforced by the compiler rather than by review. An
    // `import { Buffer } from 'node:buffer'` fails as "cannot find module"; a
    // bare `Buffer` fails as "cannot find name".
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["src/**/*"],
  // Tests may use `node:test` and `node:assert`; the shipped codec may not.
  // `tsconfig.test.json` typechecks them, and `pnpm typecheck` runs both.
  "exclude": ["src/**/*.test.ts", "src/__fixtures__/**"]
}
