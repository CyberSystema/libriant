// Libriant — Control-Plane schema.
//
// This database holds platform-level data that is never tenant-specific:
// who the tenants are, where each tenant's DB and storage live, plans &
// pricing, Libriant staff (admin) identities, support sessions, audit logs,
// announcements, and system mode. Tenant business data (books, members,
// loans) lives in per-tenant databases under a separate schema package
// (packages/db-tenant, added in a later step).
//
// Design principles enforced here:
//   - Per-tenant `db_url` and `storage_url` are first-class columns so that
//     moving a tenant between cells later is a row update, not a code change.
//   - Plans live in the DB; source code holds only the *catalog of feature
//     keys* (see @libriant/shared). Owners reshape plans via admin UI.
//   - Admins have zero default access to tenant data: support flow is
//     modeled as `support_keys` → `support_sessions` → `support_action_log`,
//     and authorization checks lean on `support_sessions.tenant_id`.
//   - Every FK has an index. Every soft-delete column lives next to a
//     `status` enum so queries can filter cleanly.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, citext, pg_trgm, unaccent]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  active
  suspended
  archived
}

/// Library category, collected at signup and shown on the library profile.
enum LibraryType {
  public
  academic
  school
  special
  community
  other
}

/// Lifecycle of a tenant-initiated request to change "core" library-profile
/// fields (name / type / address), which require platform-owner approval.
enum LibraryEditRequestStatus {
  pending
  approved
  rejected
  canceled
}

enum UserRole {
  owner // tenant owner — full library admin
  admin // library admin — almost everything except billing
  librarian // day-to-day staff
  volunteer // limited rights
}

enum UserStatus {
  invited
  active
  disabled
}

enum AdminRole {
  owner // Libriant founders / leadership
  support // Libriant support staff
}

enum AdminStatus {
  active
  locked // temporarily locked due to too many failed redemptions
  disabled
}

enum FeatureType {
  integer @map("int")
  boolean @map("bool")
  text    @map("text")
}

enum BillingMode {
  stripe
  manual
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  paused
}

enum SupportKeyStatus {
  pending
  redeemed
  expired
  revoked
}

enum SupportSessionEndReason {
  expired
  admin_ended
  library_revoked
}

enum AnnouncementSeverity {
  info
  warning
  critical
}

enum EmailOutboxStatus {
  pending
  sending
  delivered
  failed
  // Permanently abandoned after `attempts >= maxAttempts`. Kept in the
  // table for audit; the worker won't retry it.
  dead
}

enum EmailMessageKind {
  // Step 18a — support-access lifecycle
  support_key_generated
  support_key_redeemed
  support_session_ended
  // Step 18b — announcement delivery
  announcement
  // Step 7 — auth
  password_reset
  // Account email verification (signup confirmation + email-change re-verify)
  email_verification
  // Sent once after a brand-new owner verifies their address
  welcome
  // Member circulation reminders (per-library opt-in)
  member_due_soon
  member_overdue
  member_hold_ready
  // Generic catch-all for ad-hoc admin-composed mail
  transactional
  // Library-profile edit-request workflow
  library_edit_request_submitted
  library_edit_request_decided

  // A stranger applied through the marketing site's form
  application_submitted
}

enum SystemModeKind {
  normal
  maintenance
  read_only
  out_of_order
  under_construction
}

enum SystemModeScope {
  global
  tenant
}

enum AuditActorType {
  user
  admin
  system
}

// ---------------------------------------------------------------------------
// Bulk import / migration — durable job state for moving a library's existing
// catalogue + patrons + circulation INTO a tenant DB from a legacy ILS export.
// The batch row lives here (control plane) so the shared worker process can
// drive it; the actual writes land in the tenant DB.
// ---------------------------------------------------------------------------

enum ImportEntityKind {
  author
  book
  book_copy
  member
  loan
  reservation
  fine
}

enum ImportSourceFormat {
  csv
  tsv
  xlsx
  marc // MARC21 / ISO 2709 binary
  marcxml
}

enum ImportStatus {
  uploaded // file staged + columns detected; awaiting a column mapping
  validating // dry-run validation job is running
  validated // dry-run finished; report available; awaiting commit
  committing // commit job is running
  completed // commit finished with no row errors
  partially_completed // commit finished; some rows skipped / errored
  failed // fatal error (unreadable file, worker crash, canceled mid-commit)
  canceled
}

enum ImportDuplicateMode {
  skip // leave the existing row untouched; don't insert the duplicate
  update // upsert: update the matched existing row
  error // treat a duplicate as a per-row error
}

// ---------------------------------------------------------------------------
// Topology: cells, tenants, per-tenant DB credentials
// ---------------------------------------------------------------------------

/// A logical group of (DB host + app cluster + storage). The pilot ships
/// with a single cell. Tenant sharding later is just adding more rows here
/// and pointing tenants at them.
model Cell {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  region     String   @default("eu-central")
  /// Base address for tenant DBs in this cell — used as a template only.
  /// Each tenant's actual URL is stored on `tenants.db_url`.
  dbHostUrl  String?
  /// Whether this cell is open for new tenant placement.
  acceptsNew Boolean  @default(true)
  createdAt  DateTime @default(now())
  tenants    Tenant[]

  @@map("cells")
}

/// One row per library that uses Libriant. `db_url` and `storage_url` are
/// what every tenant-scoped operation in the app reads to find the right
/// database and storage backend — keeping them on the tenant row means
/// moving a tenant between hosts is a row update.
model Tenant {
  id                   String       @id @default(cuid())
  /// URL-safe identifier used in `/t/<slug>/...`.
  slug                 String       @unique
  /// Display name (e.g. "Δημοτική Βιβλιοθήκη Καλαμάτας").
  name                 String
  /// Default locale for this library — individual users can override.
  defaultLocale        String       @default("el")
  status               TenantStatus @default(active)
  cellId               String
  /// Canonical Postgres URL for THIS tenant's database. May share host with
  /// others (one Postgres, many DBs) or be on its own host post-sharding.
  dbUrl                String
  /// Canonical storage URL for THIS tenant's files. Scheme dictates driver:
  /// `file://...` (LocalDriver), `s3://...` (S3Driver), `smb://...`.
  storageUrl           String
  /// Opt-in custom subdomain (Pro/Enterprise feature). When NULL the tenant
  /// is reachable only via `/t/<slug>/`. When set, also reachable at
  /// `<custom_subdomain>.<root domain>` after wildcard DNS is wired.
  customSubdomain      String?
  /// Free-form tags for audience targeting (announcements, system mode).
  tags                 String[]     @default([])
  /// Cached file-size total (bytes), refreshed by a nightly job. Used by
  /// QuotaInterceptor to fail uploads before they touch disk.
  storageUsedBytes     BigInt       @default(0)
  /// Contact email for billing / urgent platform notices.
  primaryEmail         String       @db.Citext
  /// Per-library branding (admin-set). `brandColor` is a hex string applied
  /// as the app's primary colour; `brandLogoRef` is a tenant-storage ref
  /// (served via /t/:slug/storage/<ref>) shown in the app header. Both NULL
  /// fall back to the default Libriant theme + wordmark.
  brandColor           String?
  brandLogoRef         String?
  /// Legal consent at the LIBRARY (contracting party) level: the version of the
  /// Terms of Service + DPA accepted by the owner at signup, and when. Mirrors
  /// the owner User's record so the contracting entity's acceptance is queryable
  /// even if the owner account is later changed.
  legalAcceptedVersion String?
  legalAcceptedAt      DateTime?

  /// --- Library profile (collected at signup; visible to the tenant + platform
  /// owner-admins). "Core" fields (name above, libraryType, address*) can only
  /// be changed via an owner-approved LibraryEditRequest; the "free" fields
  /// (public contact + description) are editable directly by tenant owner/admin.
  libraryType       LibraryType?
  addressStreet     String?
  addressCity       String?
  addressPostalCode String?
  /// Region / prefecture (περιφέρεια / νομός). Free text for flexibility.
  addressRegion     String?
  /// ISO-3166 alpha-2 country code (e.g. "GR"). Free text, defaults to GR.
  addressCountry    String?      @default("GR")
  publicPhone       String?
  publicEmail       String?      @db.Citext
  website           String?
  description       String?
  foundedYear       Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  cell                   Cell                   @relation(fields: [cellId], references: [id], onDelete: Restrict)
  dbCredentials          TenantDbCredential?
  users                  User[]
  subscription           Subscription?
  billingAccount         BillingAccount?
  planOverrides          TenantPlanOverride[]
  auditEvents            AuditEvent[]
  libraryEditRequests    LibraryEditRequest[]
  supportKeys            SupportKey[]
  supportSessions        SupportSession[]
  announcementDeliveries AnnouncementDelivery[]
  systemModeEvents       SystemModeEvent[]
  emailOutbox            EmailOutbox[]
  importBatches          ImportBatch[]

  @@index([cellId])
  @@index([status])
  // partial unique index on custom_subdomain WHERE NOT NULL is added in
  // the migration SQL (Prisma can't express partial uniques natively).
  @@map("tenants")
}

/// Sensitive per-tenant DB role secret, separated from the URL so we can
/// rotate / re-encrypt independently. Stored as ciphertext + key id.
model TenantDbCredential {
  tenantId        String   @id
  /// Postgres role name owning this tenant's DB.
  roleName        String
  /// AES-GCM ciphertext of the role password.
  encryptedPwd    Bytes
  /// Identifier of the key used to encrypt — supports rotation.
  encryptionKeyId String
  /// Nonce/IV for the encryption.
  encryptionNonce Bytes
  rotatedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_db_credentials")
}

// ---------------------------------------------------------------------------
// Library users (tenant staff): identity lives here so login can resolve a
// user before we open the tenant DB. Tenant-specific user *preferences*
// will live in the tenant DB later.
// ---------------------------------------------------------------------------

model User {
  id                    String     @id @default(cuid())
  tenantId              String
  /// CITEXT email per tenant — same human can have accounts at multiple
  /// libraries, each treating emails case-insensitively. NULL for admin-created
  /// staff, who sign in with `username` instead (no email on file).
  email                 String?    @db.Citext
  /// CITEXT login handle per tenant for admin-created staff (e.g. `staff_3`).
  /// Owners/admins created via signup/invite use `email`; staff use this.
  /// Login accepts either. NULL for email-based accounts.
  username              String?    @db.Citext
  fullName              String
  role                  UserRole   @default(librarian)
  status                UserStatus @default(invited)
  /// When true, the user is forced through a one-time "set your name + password"
  /// screen on next login before they can use the app. Set when an admin
  /// creates a staff account or resets its password.
  mustChangeCredentials Boolean    @default(false)
  /// Per-user override for the tenant's default locale.
  locale                String?
  passwordHash          String?
  /// AES-GCM ciphertext of the TOTP secret (when enabled).
  mfaSecretCipher       Bytes?
  mfaNonce              Bytes?
  mfaKeyId              String?
  mfaEnabled            Boolean    @default(false)
  /// One-shot token consumed during onboarding to set password.
  inviteToken           String?
  inviteExpires         DateTime?
  lastLoginAt           DateTime?
  failedLogins          Int        @default(0)
  lockedUntil           DateTime?
  /// Any session JWT issued (iat) strictly before this instant is rejected by
  /// AuthGuard. Bumped on password reset / forced credential reset / role or
  /// status change so a compromised-then-recovered account can't keep a live
  /// cookie for the rest of its 7-day TTL.
  sessionsValidAfter    DateTime?
  /// When the user confirmed ownership of `email` via a verification link.
  /// NULL = unverified (soft-gated: can sign in, but verification-sensitive
  /// actions are blocked until set). Staff accounts have no email, so they are
  /// treated as exempt rather than unverified.
  emailVerifiedAt       DateTime?
  /// Legal consent (GDPR/contract accountability): which version of the Terms +
  /// Privacy Policy this user accepted, when, and from which IP. Set for the
  /// owner at signup; NULL for admin-created staff (they don't sign the SaaS
  /// terms — the library, as their employer, is the contracting party).
  legalAcceptedVersion  String?
  legalAcceptedAt       DateTime?
  legalAcceptedIp       String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  archivedAt            DateTime?

  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supportKeysCreated     SupportKey[]
  announcementDeliveries AnnouncementDelivery[]

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId, status])
  @@index([email])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Plans, features, overrides, subscriptions, billing
// ---------------------------------------------------------------------------

/// The MENU of feature keys the system understands. Seeded from
/// @libriant/shared/features.ts. Values for a specific plan live in
/// `plan_feature_values`; per-tenant overrides in `tenant_plan_overrides`.
model PlanFeature {
  key         String      @id
  type        FeatureType
  label       String
  description String
  /// Default value used when no plan nor override covers this feature.
  defaultInt  Int?
  defaultBool Boolean?
  defaultText String?
  /// Optional unit hint (e.g. `count`, `mb`, `days`, `seats`).
  unit        String?
  /// Display order in the admin UI.
  sortOrder   Int         @default(0)

  values    PlanFeatureValue[]
  overrides TenantPlanOverride[]

  @@map("plan_features")
}

/// A subscription plan the owner has defined. Plans are fully managed in
/// the admin UI — code never assumes specific plan names exist.
model Plan {
  id                  String      @id @default(cuid())
  slug                String      @unique
  name                String
  description         String?
  billingMode         BillingMode @default(stripe)
  /// Stripe Price ID for the monthly cadence — required when billingMode = stripe.
  stripePriceId       String?     @unique
  monthlyPriceCents   Int         @default(0)
  /// Stripe Price ID for the annual cadence. Optional: a plan may be
  /// monthly-only. Separate from stripePriceId because a Stripe Price is
  /// immutable and each billing interval is its own Price object.
  stripeAnnualPriceId String?     @unique
  /// Annual price. NULL means the plan is not offered annually.
  ///
  /// Greek public buyers contract annually and pay against a single invoice —
  /// twelve monthly payments would mean twelve χρηματικά εντάλματα and twelve
  /// committee receipt protocols a year. The convention here is ten months for
  /// twelve, so annualPriceCents = monthlyPriceCents × 10.
  annualPriceCents    Int?
  currency            String      @default("EUR")
  /// Hide from new-customer self-serve picker (still usable via admin).
  isActive            Boolean     @default(true)
  /// Hide from public plan list entirely (legacy / experimental plans).
  isPublic            Boolean     @default(true)
  sortOrder           Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  archivedAt          DateTime?

  values        PlanFeatureValue[]
  subscriptions Subscription[]

  @@index([isActive])
  @@map("plans")
}

/// One row per (plan, feature) pair. Typed cells let us index/query
/// without JSON gymnastics. Exactly one of value_* should be non-null,
/// matching the feature's type (enforced by a CHECK constraint in SQL).
model PlanFeatureValue {
  planId     String
  featureKey String
  valueInt   Int?
  valueBool  Boolean?
  valueText  String?

  plan    Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature PlanFeature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@id([planId, featureKey])
  @@index([featureKey])
  @@map("plan_feature_values")
}

/// Per-tenant override: wins over the plan value. Used for negotiated
/// deals ("Acme gets +1000 books on Community") and break-glass tweaks.
model TenantPlanOverride {
  id               String    @id @default(cuid())
  tenantId         String
  featureKey       String
  valueInt         Int?
  valueBool        Boolean?
  valueText        String?
  /// When the override stops applying (NULL = forever).
  expiresAt        DateTime?
  note             String?
  createdByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature        PlanFeature @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  createdByAdmin AdminUser?  @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@unique([tenantId, featureKey])
  @@index([featureKey])
  @@map("tenant_plan_overrides")
}

/// The current subscription state for a tenant. Stripe webhooks + manual
/// billing both write here; downstream code reads only this table.
model Subscription {
  tenantId             String             @id
  planId               String
  /// Denormalized from the plan so subscription queries don't always need
  /// a join, and we can record what was billed even if the plan changes.
  billingMode          BillingMode
  status               SubscriptionStatus @default(active)
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  /// For manual-billed plans: until when the tenant is considered paid.
  paidUntil            DateTime?
  /// Grace period after a failed payment before features get gated.
  graceUntil           DateTime?
  canceledAt           DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  /// When the tenant *explicitly* chose this plan. NULL = never chosen — a
  /// fresh signup, or a tenant that signed up while subscriptions were
  /// disabled (the planId then is just the Starter placeholder). When billing
  /// is enabled, a NULL here forces the full-page plan chooser before the
  /// library can be used; choosing any plan (even free) stamps it.
  planSelectedAt       DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

/// Stripe customer + EU VAT details. One row per tenant.
model BillingAccount {
  tenantId               String   @id
  stripeCustomerId       String?  @unique
  defaultPaymentMethodId String?
  billingEmail           String   @db.Citext
  billingName            String
  /// EU VAT or other tax identifier (libraries are often VAT-exempt; column
  /// is optional).
  taxId                  String?
  taxCountry             String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  postalCode             String?
  country                String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("billing_accounts")
}

/// Global, owner-controlled runtime settings — toggled from the admin panel
/// without a redeploy. A simple typed-as-text key/value store (parse on read).
/// Current keys:
///   - `billing.enabled` ("true" | "false") — master subscriptions switch.
/// When a key is absent the reader falls back to the matching env var
/// (`BILLING_ENABLED`), so behaviour is unchanged until the owner sets it once.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Operator maintenance — admin-launched, worker-run jobs over the control DB
// and/or tenant DBs (diagnostics, migrations, integrity fixers, VACUUM).
// One row per launched run; the worker streams progress + a structured result.
// ---------------------------------------------------------------------------

enum MaintenanceKind {
  diagnostics // read-only health + issue scan
  migrate // apply pending Prisma migrations
  fix // data-integrity repairs (reseed settings, rebuild caches)
  vacuum // VACUUM (ANALYZE) for bloat/perf
}

enum MaintenanceScope {
  tenant // a single tenant DB (targetTenantId set)
  control // the control-plane DB
  all // every tenant DB (and control, where the kind applies)
}

enum MaintenanceStatus {
  queued
  running
  completed
  failed
}

model MaintenanceRun {
  id               String            @id @default(cuid())
  kind             MaintenanceKind
  scope            MaintenanceScope
  /// Set when scope = tenant.
  targetTenantId   String?
  status           MaintenanceStatus @default(queued)
  /// Progress counters the UI polls (e.g. tenant DBs processed / total).
  progressDone     Int               @default(0)
  progressTotal    Int               @default(0)
  /// Structured outcome: per-target results and, for diagnostics, the list of
  /// issues found (with severity). Shape is owned by the worker processors.
  resultJson       Json?
  error            String?
  /// AdminUser.id that launched it (plain column — no FK, audit log covers who).
  createdByAdminId String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([kind, createdAt])
  @@index([status])
  @@map("maintenance_runs")
}

// ---------------------------------------------------------------------------
// Database export — admin/library-admin launched, worker-run dumps of a tenant
// DB, the control DB, or everything, into a downloadable file.
// ---------------------------------------------------------------------------

enum ExportFormat {
  csv // zip of one CSV per table
  json // one JSON file: { table: rows }
  xlsx // one Excel workbook, a sheet per table
  sql // pg_dump (full-fidelity, restorable)
}

enum ExportScope {
  tenant // a single library's DB
  control // the control-plane DB (owner only)
  all // control + every tenant DB, bundled (owner only)
}

enum ExportStatus {
  queued
  running
  completed
  failed
}

enum ExportRequesterKind {
  admin // owner-admin (AdminUser)
  user // a library admin (tenant User)
}

model ExportJob {
  id              String              @id @default(cuid())
  format          ExportFormat
  scope           ExportScope
  /// Set when scope = tenant.
  targetTenantId  String?
  requestedByKind ExportRequesterKind
  /// AdminUser.id or User.id (plain column — no FK across the kinds).
  requestedById   String
  status          ExportStatus        @default(queued)
  progressDone    Int                 @default(0)
  progressTotal   Int                 @default(0)
  /// Produced artifact: download filename + absolute path under STORAGE_ROOT.
  fileName        String?
  filePath        String?
  fileBytes       Int?
  error           String?
  startedAt       DateTime?
  finishedAt      DateTime?
  /// When the file may be purged by a cleanup sweep.
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([targetTenantId, createdAt])
  @@index([requestedByKind, requestedById, createdAt])
  @@index([status])
  @@map("export_jobs")
}

/// Idempotency log for Stripe webhooks. Insert-once-per-event; the unique
/// constraint on the event id means re-deliveries are no-ops.
model StripeWebhookEvent {
  id          String    @id // Stripe event id (`evt_…`)
  type        String
  /// Raw event body for replay / debug. Pruned after 30 days.
  payloadJson Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  /// If processing errored — readable message; the job retries until success.
  error       String?

  @@index([type, receivedAt])
  @@map("stripe_webhook_events")
}

// ---------------------------------------------------------------------------
// Email outbox — durable queue of outbound transactional mail.
//
// Two-table pattern (this row + a BullMQ Redis job): callers write the row
// inside the same transaction that produced the trigger (announcement,
// support key generation, password reset, …) so the email is guaranteed
// to be ENQUEUED iff the trigger committed. The worker reads the row,
// sends via the configured driver, and updates `status` + delivery /
// failure timestamps. Retries are BullMQ's job (exponential backoff,
// up to `maxAttempts`); after that the row goes `dead` and stays for
// audit + manual replay.
//
// `idempotencyKey` is the de-dupe lever: an upsert keyed on it makes
// re-trying the producing transaction a no-op, so a 18b announcement
// publish that retries doesn't email the same library twice.
// ---------------------------------------------------------------------------

model EmailOutbox {
  id             String            @id @default(cuid())
  /// Free-form key the producer chooses so re-runs don't double-send. For
  /// 18b: `announcement:<id>:tenant:<tenantId>`. For 18a support events:
  /// `support.key.generated:<keyId>`. NULL means "send unconditionally".
  idempotencyKey String?           @unique
  kind           EmailMessageKind
  /// Envelope. `fromEmail` is rendered with `EMAIL_FROM` when null.
  toEmail        String            @db.Citext
  fromEmail      String?           @db.Citext
  replyToEmail   String?           @db.Citext
  subject        String
  /// Plain-text body. The driver may also render a sanitized HTML version
  /// from the markdown captured in `bodyMarkdown`. We keep both so the
  /// worker can fall back to plain text on SMTP servers that reject HTML.
  bodyMarkdown   String
  /// What this email is "about" — used by stats + admin search. Mirrors
  /// the (tenantId, kind, …) the producer cares about.
  tenantId       String?
  /// Per-row metadata the producer wants to surface in admin UI (e.g.
  /// `{ announcementId, deliveryId }` for 18b). Opaque to the worker.
  metadataJson   Json              @default("{}")
  status         EmailOutboxStatus @default(pending)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(5)
  /// Earliest time the worker may try this row. Producer sets it when
  /// scheduling a future send (defaults to NOW for "send asap"). BullMQ
  /// re-enqueues with backoff; this column is the source-of-truth.
  scheduledFor   DateTime          @default(now())
  /// Set on `delivered`. Driver's identifier (Message-ID, etc.).
  providerId     String?
  /// Set on a transient failure that will be retried.
  lastError      String?
  deliveredAt    DateTime?
  failedAt       DateTime?
  /// Set on a permanent abandonment (>= maxAttempts).
  abandonedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  /// privacy-legal-04: CASCADE, not SetNull.
  ///
  /// `bodyMarkdown` and `toEmail` on a member notice are a named patron's
  /// e-mail address and the title of the book they borrowed — the highest-
  /// sensitivity item in the system, sitting in the SHARED control plane. With
  /// `SetNull` those rows survived an admin hard-delete of the library with
  /// `tenantId = NULL`, which is worse than keeping them: nothing linked them
  /// to a tenant any more, so no future erasure or retention sweep could even
  /// find them, and under Art. 28(10) we would have become the controller for
  /// data we were never instructed to keep.
  ///
  /// Nothing references an outbox row, and once the library is gone its
  /// delivery history has no operational reader — so the row goes with it.
  /// (The control-plane audit_log deliberately does NOT cascade; it is
  /// redacted instead, so the record that the deletion happened survives.
  /// See the `tenants_redact_pii_before_delete` trigger.)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Worker polls `WHERE status='pending' AND scheduledFor <= now()`;
  // BullMQ does the actual reservation, this index is the cold-start
  // recovery path.
  @@index([status, scheduledFor])
  @@index([tenantId, kind, createdAt])
  @@map("email_outbox")
}

// ---------------------------------------------------------------------------
// Libriant admins: separate identity table from tenant `users`, so the auth
// surfaces are independent and an admin can never accidentally be granted
// tenant-level access without going through the support flow.
// ---------------------------------------------------------------------------

model AdminUser {
  id                 String      @id @default(cuid())
  email              String      @unique @db.Citext
  fullName           String
  role               AdminRole   @default(support)
  status             AdminStatus @default(active)
  passwordHash       String
  mfaSecretCipher    Bytes
  mfaNonce           Bytes
  mfaKeyId           String
  /// MFA must be enabled before this admin can redeem support keys.
  mfaEnabled         Boolean     @default(false)
  lastLoginAt        DateTime?
  failedAttempts     Int         @default(0)
  lockedUntil        DateTime?
  /// Any admin session JWT issued (iat) before this instant is rejected by
  /// AdminAuthGuard — lets a forced password reset / disable end live sessions.
  sessionsValidAfter DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  disabledAt         DateTime?

  supportSessions         SupportSession[]
  supportKeysRedeemed     SupportKey[]               @relation("RedeemedByAdmin")
  announcementsCreated    Announcement[]
  systemModeEventsCreated SystemModeEvent[]
  tenantOverridesCreated  TenantPlanOverride[]
  redemptionAttempts      SupportRedemptionAttempt[]

  @@index([status])
  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Support access — admin "break-glass" into a tenant.
// Flow: library admin generates SupportKey → admin redeems it (with MFA) →
// SupportSession opens → every action is logged in SupportActionLog →
// session ends by expiry, admin choice, or library revocation.
// ---------------------------------------------------------------------------

model SupportKey {
  id                String           @id @default(cuid())
  tenantId          String
  createdByUserId   String
  /// bcrypt hash of the random body of the code (the part after "SUPPORT-").
  codeHash          String
  /// First 4 chars of the random body, used to narrow the bcrypt lookup at
  /// redemption time to a small candidate set.
  codePrefix        String
  generatedAt       DateTime         @default(now())
  expiresAt         DateTime
  redeemedAt        DateTime?
  redeemedByAdminId String?
  redeemedFromIp    String?
  status            SupportKeyStatus @default(pending)
  /// Set when redemption succeeds.
  sessionId         String?          @unique
  revokedAt         DateTime?
  revokedReason     String?

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  User            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  redeemedBy AdminUser?      @relation("RedeemedByAdmin", fields: [redeemedByAdminId], references: [id], onDelete: SetNull)
  session    SupportSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // partial unique index `tenantId WHERE status = 'pending'` is added in
  // the migration SQL to enforce "at most one pending key per tenant".
  @@index([tenantId, status])
  @@index([codePrefix, status])
  @@index([expiresAt])
  @@map("support_keys")
}

model SupportSession {
  id           String                   @id @default(cuid())
  tenantId     String
  adminId      String
  supportKeyId String                   @unique
  startedAt    DateTime                 @default(now())
  expiresAt    DateTime
  endedAt      DateTime?
  endedReason  SupportSessionEndReason?
  ipAddress    String?
  userAgent    String?

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admin   AdminUser          @relation(fields: [adminId], references: [id], onDelete: Restrict)
  actions SupportActionLog[]
  key     SupportKey?

  @@index([tenantId])
  @@index([adminId])
  @@index([endedAt])
  @@map("support_sessions")
}

model SupportActionLog {
  id         String   @id @default(cuid())
  sessionId  String
  ts         DateTime @default(now())
  method     String
  path       String
  status     Int
  /// What was touched: e.g. `book`, `member`. NULL for read-only / list endpoints.
  targetType String?
  targetId   String?
  /// Pre-mutation state captured by Prisma middleware.
  beforeJson Json?
  /// Post-mutation state.
  afterJson  Json?

  session SupportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, ts])
  @@index([ts])
  @@map("support_action_log")
}

/// Rate-limit + brute-force defenses for the redemption endpoint.
model SupportRedemptionAttempt {
  id         String   @id @default(cuid())
  adminId    String?
  ipAddress  String?
  ts         DateTime @default(now())
  success    Boolean
  /// If we recognized the prefix but the bcrypt compare failed → record so
  /// we can spot scanning behavior.
  codePrefix String?

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, ts])
  @@index([ipAddress, ts])
  @@map("support_redemption_attempts")
}

// ---------------------------------------------------------------------------
// Audit log — platform-wide events. Tenant-side audit (book added, etc.)
// lives in the tenant DB and is a separate concern.
// ---------------------------------------------------------------------------

model AuditEvent {
  id         String         @id @default(cuid())
  /// NULL = platform-wide event (e.g. global maintenance toggle).
  tenantId   String?
  actorType  AuditActorType
  actorId    String?
  /// e.g. `tenant.created`, `subscription.changed`, `support.key.redeemed`.
  action     String
  targetType String?
  targetId   String?
  beforeJson Json?
  afterJson  Json?
  ip         String?
  userAgent  String?
  occurredAt DateTime       @default(now())

  /// privacy-legal-04: stays SetNull ON PURPOSE, unlike `email_outbox`.
  ///
  /// Cascading here would delete the `tenant.deleted` audit row in the same
  /// statement that recorded it — destroying the evidence that a library was
  /// hard-deleted, which is the one event you most need to be able to prove.
  /// Instead a `BEFORE DELETE ON tenants` trigger
  /// (`tenants_redact_pii_before_delete`, added in migration
  /// 20260824120000_tenant_delete_pii) overwrites `beforeJson` / `afterJson` /
  /// `ip` / `userAgent` on this tenant's rows first, keeping `action` +
  /// `occurredAt` + the library's slug and dropping the payload. The trigger,
  /// not the delete endpoint, is where this lives — it then holds for every
  /// path that can delete a tenant, including a DBA at a psql prompt.
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([actorType, actorId, occurredAt])
  @@index([targetType, targetId])
  @@index([action, occurredAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Library-profile edit requests — a tenant admin proposes new values for the
// "core" profile fields (name / type / address); a platform owner-admin
// approves (the proposed values are applied to the Tenant) or rejects. At most
// one `pending` request per tenant at a time (enforced in the service).
// ---------------------------------------------------------------------------

model LibraryEditRequest {
  id                String                   @id @default(cuid())
  tenantId          String
  status            LibraryEditRequestStatus @default(pending)
  /// The proposed new values for the gated fields, as a JSON patch
  /// (e.g. { "name": "...", "libraryType": "public", "addressCity": "..." }).
  proposedJson      Json
  /// Snapshot of the current values at request time, for an auditable diff.
  beforeJson        Json
  /// The tenant user who submitted the request (User.id) + optional reason.
  requestedByUserId String
  requestNote       String?
  /// The platform admin who decided (AdminUser.id) + optional note + when.
  reviewedByAdminId String?
  decisionNote      String?
  reviewedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([tenantId, createdAt])
  @@map("library_edit_requests")
}

// ---------------------------------------------------------------------------
// Announcements — admin → libraries, in-app + email, audience-targeted.
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  new
  contacted
  accepted
  rejected
}

/// An application from the public marketing site's form at libriant.com.
///
/// Deliberately NOT shaped like LibraryEditRequest: that models a request from
/// an authenticated tenant member against a row that already exists. An
/// application precedes the tenant existing at all, so there is no tenantId, no
/// requesting user and no before/after patch — only the answers, and the review
/// scaffolding copied from that model.
///
/// What is NOT stored is as deliberate as what is. No IP, no IP hash, no
/// country, no user agent: none of them is needed to answer an application, and
/// Art. 5(1)(c) does not allow collecting data no purpose requires. Abuse
/// throttling keys on a peppered hash held in Redis for an hour and never
/// reaches this table.
model Application {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  libraryName  String
  libraryType  LibraryType
  city         String
  contactName  String
  contactEmail String      @db.Citext
  phone        String?

  collectionSize String?
  currentSystem  String?
  message        String?

  /// The acknowledgement as submitted, not a literal — this row is the evidence
  /// of what the applicant actually did.
  consent        Boolean
  /// Which version of the privacy notice was on screen at submission time.
  privacyVersion String

  /// Set by the outbox worker on real delivery, not on enqueue.
  notified    Boolean @default(false)
  notifyError String?

  status            ApplicationStatus @default(new)
  reviewedByAdminId String?
  decisionNote      String?
  reviewedAt        DateTime?

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("applications")
}

model Announcement {
  id               String               @id @default(cuid())
  title            String
  bodyMarkdown     String
  severity         AnnouncementSeverity @default(info)
  /// JSON shape: `{ all: true } | { tenant_ids: [...] } | { plan_slugs: [...] } | { tags: [...] }`
  audienceFilter   Json
  deliverInApp     Boolean              @default(true)
  deliverEmail     Boolean              @default(false)
  /// When the banner becomes visible / email goes out. NULL = immediately.
  publishAt        DateTime?
  /// After this, the banner disappears even if not dismissed.
  expiresAt        DateTime?
  dismissible      Boolean              @default(true)
  /// If true, library users must click acknowledge before continuing.
  requiresAck      Boolean              @default(false)
  createdByAdminId String
  createdAt        DateTime             @default(now())
  publishedAt      DateTime?
  archivedAt       DateTime?

  createdByAdmin AdminUser              @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)
  deliveries     AnnouncementDelivery[]

  @@index([publishAt])
  @@index([expiresAt])
  @@map("announcements")
}

model AnnouncementDelivery {
  id               String    @id @default(cuid())
  announcementId   String
  /// Whose copy of the announcement this is. NULL on tenant_id means a
  /// preview/test delivery; NULL on user_id means tenant-wide (not user-specific).
  tenantId         String?
  userId           String?
  deliveredInAppAt DateTime?
  deliveredEmailAt DateTime?
  dismissedAt      DateTime?
  acknowledgedAt   DateTime?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, tenantId, userId])
  @@index([tenantId, announcementId])
  @@index([userId, announcementId])
  @@map("announcement_deliveries")
}

// ---------------------------------------------------------------------------
// System mode — maintenance / read_only / out_of_order / under_construction
// across the whole platform or for a single tenant, scheduled or immediate.
// The effective state at any moment is the most-recent applicable event whose
// [starts_at, ends_at] window covers now.
// ---------------------------------------------------------------------------

model SystemModeEvent {
  id               String          @id @default(cuid())
  scope            SystemModeScope
  /// Required when scope = tenant; must be NULL when scope = global.
  tenantId         String?
  mode             SystemModeKind
  messageMarkdown  String?
  startsAt         DateTime        @default(now())
  endsAt           DateTime?
  /// If false, /admin/* paths are also blocked during the mode (rare).
  allowAdminBypass Boolean         @default(true)
  createdByAdminId String
  createdAt        DateTime        @default(now())
  /// Set when the admin manually exits the mode early.
  endedAt          DateTime?

  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByAdmin AdminUser @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)

  @@index([scope, startsAt])
  @@index([tenantId, startsAt])
  @@index([endsAt])
  @@map("system_mode_events")
}

// ---------------------------------------------------------------------------
// Help center — in-product knowledge base. Articles are authored as
// Markdown files in /locales/<lang>/help/ and ingested into this table via
// `scripts/ingest-help-articles.ts`. Postgres FTS lives in a tsvector
// column populated by trigger; Prisma doesn't see the column directly, we
// query through it with `$queryRawUnsafe` from the help service.
// ---------------------------------------------------------------------------

model HelpArticle {
  id           String    @id @default(cuid())
  /// URL-safe per-locale identifier ("adding-members"). Same article in
  /// en/el shares the slug but is two distinct rows so search results
  /// match the user's language without cross-language fallthrough.
  slug         String
  /// BCP-47 locale tag the article body is written in.
  locale       String
  title        String
  /// Plain-text summary shown in list views (one sentence).
  summary      String
  /// Comma-separated keywords surfaced as chips. Optional.
  tags         String?
  /// Sort key within a locale. The ingest script reads the leading digits
  /// from the filename ("01-getting-started.md" → 10) so editors stay in
  /// charge of ordering without an admin UI.
  sortOrder    Int       @default(100)
  /// Source Markdown — kept so re-ingest is round-trippable + human-readable.
  bodyMarkdown String
  /// Rendered HTML, sanitized at ingest. The UI uses this for fast SSR.
  bodyHtml     String
  /// SHA-256 of the source file at ingest time; skips no-op upserts.
  sourceHash   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Set when the source file disappears between ingest runs. Records
  /// stay archived rather than vanishing so a librarian's bookmark still
  /// gives them a friendly "this article was retired" page.
  archivedAt   DateTime?

  @@unique([slug, locale])
  @@index([locale, sortOrder])
  @@map("help_articles")
}

// ---------------------------------------------------------------------------
// Import batches — one row per uploaded migration file. Drives a 4-step
// flow: upload → map columns → dry-run validate → commit. Progress + counts
// live here; per-row problems live in `import_row_issues`.
// ---------------------------------------------------------------------------

model ImportBatch {
  id            String              @id @default(cuid())
  tenantId      String
  entityKind    ImportEntityKind
  format        ImportSourceFormat
  status        ImportStatus        @default(uploaded)
  /// Original client filename (display only).
  originalName  String
  /// Path to the staged raw upload under STORAGE_ROOT/_imports — shared
  /// across the api + worker containers so the worker can re-read it for
  /// the validate + commit passes. Cleaned up after the batch finishes.
  stagingPath   String
  sizeBytes     Int                 @default(0)
  /// Detected/declared character encoding (`utf-8`, `windows-1253`, …).
  encoding      String?
  /// Field delimiter for csv/tsv (`,` `\t` `;` `|`).
  delimiter     String?
  /// Worksheet name for xlsx imports.
  sheetName     String?
  hasHeaderRow  Boolean             @default(true)
  /// Detected source columns + a few sample rows, surfaced in the mapping UI.
  columnsJson   Json                @default("{}")
  /// Column→field mapping + per-column transforms + custom-field targets.
  mappingJson   Json?
  /// Run options: static defaults, skipInvalidRows, etc.
  optionsJson   Json                @default("{}")
  duplicateMode ImportDuplicateMode @default(skip)

  totalRows       Int     @default(0)
  validRows       Int     @default(0)
  errorRows       Int     @default(0)
  warningRows     Int     @default(0)
  importedRows    Int     @default(0)
  updatedRows     Int     @default(0)
  skippedRows     Int     @default(0)
  /// True when the per-row issue list was capped (a very dirty file).
  issuesTruncated Boolean @default(false)

  /// Control-plane User.id of the librarian who started the import. Stored as
  /// a plain id (not a FK) — it's an audit pointer, mirroring how cross-record
  /// actor ids are kept elsewhere (e.g. audit_log.actorId).
  createdByUserId String?
  /// Fatal error summary when status = failed.
  error           String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issues ImportRowIssue[]

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("import_batches")
}

model ImportRowIssue {
  id        String   @id @default(cuid())
  batchId   String
  /// `validate` or `commit` — which pass produced the issue.
  phase     String
  /// 1-based row number in the source file (header excluded).
  rowNumber Int
  /// `error` blocks the row; `warning` is informational (row still imported).
  severity  String
  /// Target field key when the issue is field-specific (else null).
  field     String?
  /// Machine-readable code: `required`, `invalid_value`, `duplicate`,
  /// `reference_not_found`, `quota_exceeded`, `db_rejected`, …
  code      String
  message   String
  /// Compact snapshot of the offending source row, for the errors.csv export.
  rawJson   Json?
  createdAt DateTime @default(now())

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, rowNumber])
  @@index([batchId, severity])
  @@map("import_row_issues")
}
