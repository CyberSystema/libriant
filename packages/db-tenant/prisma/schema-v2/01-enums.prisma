  itemTypeDefault
  fixedAmount
  actualCost

  @@map("lost_item_fee_basis")
}

/// The three request kinds §5 names for NCIP and SIP2.
enum HoldRequestType {
  page
  hold
  recall

  @@map("hold_request_type")
