// ---------------------------------------------------------------------------
// Circulation — patrons and loans
// ---------------------------------------------------------------------------

/// A borrower.
///
/// PHASE 14 FILLED THIS IN. The baseline left it the emptiest skeleton in the
/// tree — §3 mentions `patrons` nine times and every mention is about BEHAVIOUR
/// (anonymisation on return, merge resolving through one hop, number minting via
/// `UPDATE … RETURNING` rather than `max()+1`) and none is about a column — on
/// the argument that a patron record is where GDPR, the Greek digital-consent
/// age of 15 and the DSAR bundle all land, and inventing its shape a dozen
/// phases early would be inventing the hardest part of the schema with the least
/// information. Phase 14 is the phase that has that information.
///
/// The columns are 1.0's `members`, which is not a shortcut: those are the
/// fields this product already collects from Greek libraries, and a 2.0 patron
/// that held different ones would make phase 19's copy-forward lossy for no
/// reason. What is NEW is `merged_into_id`, `expires_at`, `erased_at`'s
/// promotion to a first-class column, and the fact that the address, the card
/// and the identifiers have moved OUT into satellite tables — 1.0 holds exactly
/// one address inline and cannot record a second card, which is the first thing
/// a library with a lost-card replacement policy needs.
///
/// THE IDENTITY SIDE IS NOT HERE. §3 splits the twenty patron tables into a
/// record side (this phase) and an identity side — `patron_identities`,
/// `patron_sessions`, `patron_auth_providers`, `patron_registrations`,
/// `patron_privacy_settings`, `patron_contact_endpoints`,
/// `patron_channel_preferences`, `patron_households` — which is phase 32, where
/// a patron can log in to the OPAC. A borrower who has never had an account is
/// the normal case and must stay expressible.
/// @replicated entity_kind=patron
model Patron {
  id String @id @default(cuid())

  /// `M-2026-000001`. Unique among non-archived rows, and served by TWO indexes
  /// that cannot be one — see the migration, which measures why.
  ///
  /// Nullable, because a patron created by a bulk import may not have one yet
  /// and a fast-add at the desk should not block on minting. `mintPatronNumber`
  /// fills it; nothing else may.
  patronNumber String? @map("patron_number")

  fullName String  @map("full_name")
  /// Folded and lowercased by `@libriant/shared/greek`. What every list sorts
  /// by, and the reason it is a stored column rather than an expression: the
  /// fold is the one in TypeScript, not one Postgres could reproduce.
  sortName String  @map("sort_name")
  /// Name + number + email + phone, folded, for the trigram index.
  searchText String @map("search_text")

  /// `citext`, as in 1.0: a library that types `Α.Παπαδοπουλου@…` and one that
  /// types `a.papadopoulou@…` mean the same patron.
  email String? @db.Citext
  phone String?
  /// A civil date, so `@db.Date`. A birthday is the same day everywhere, and
  /// `ageRestrictionMinYears` in the rules matrix reads it.
  dateOfBirth DateTime? @db.Date @map("date_of_birth")

  photoAssetRef String? @map("photo_asset_ref")

  status PatronStatus @default(active)
  /// When the borrowing right lapses. NULL is "does not expire", which is what a
  /// public library's ordinary adult member gets; a student card that expires
  /// with the academic year is the case this exists for. Phase 16 reads it —
  /// this phase only stores it, because there is no checkout to block yet.
  expiresAt DateTime? @db.Timestamptz(3) @map("expires_at")

  /// Visible to staff, never to the patron. 1.0's `staffNotes`, kept inline
  /// rather than folded into `patron_notes` because a one-line "prefers large
  /// print" is not a dated, attributed note and forcing it to be one is how a
  /// field stops being used.
  staffNotes String? @map("staff_notes")

  joinedAt     DateTime @default(now()) @db.Timestamptz(3) @map("joined_at")
  customFields Json     @default("{}") @db.JsonB @map("custom_fields")

  /// Set when this record LOSES a merge. The survivor keeps its own id, so every
  /// loan, fee, hold and audit target pointing at the loser still resolves —
  /// `marc_records.merged_into_id` uses the identical wording for the identical
  /// reason.
  ///
  /// IT IS ALWAYS ONE HOP. When A is merged into C, every row that pointed at A
  /// is re-pointed to C in the same transaction, and a deferred constraint
  /// trigger refuses the commit otherwise. That is not tidiness: measured, a
  /// chain does not make the card scan SLOW — a one-hop lookup is a fixed 12
  /// buffers whatever the depth — it makes it silently WRONG, returning a patron
  /// who is themselves merged away. The desk then charges the loan to a record
  /// with no cards, no blocks and a balance nobody sees.
  mergedIntoId String? @map("merged_into_id")

  /// GDPR Art. 17. When non-NULL every direct identifier above has been
  /// overwritten and the row exists ONLY to keep the loan and fee foreign keys
  /// resolvable. NEVER re-populate an erased row: restoring identifiers undoes
  /// an exercised erasure right.
  erasedAt DateTime? @db.Timestamptz(3) @map("erased_at")

  /// PHASE 13 GAVE THIS ITS FK. It used to say `patron_categories` was deferred
  /// to 9c; the rules matrix keys on it, and a rule selecting on a category that
  /// does not exist is a rule that silently never matches — a failure
  /// `resolve.ts` cannot see, because a non-matching selector is
  /// indistinguishable from a deliberate one. `ON DELETE RESTRICT`: a category
  /// with members is not deletable, which is also what every rule naming it
  /// needs.
  patronCategoryId String? @map("patron_category_id")
  homeBranchId     String? @map("home_branch_id")

  createdAt  DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt  DateTime  @db.Timestamptz(3) @map("updated_at")
  archivedAt DateTime? @db.Timestamptz(3) @map("archived_at")

  loans    Loan[]
  category PatronCategory? @relation(fields: [patronCategoryId], references: [id], onDelete: Restrict)

  /// `ON DELETE RESTRICT`, not the `SET NULL` `marc_records` uses. Silently
  /// clearing a loser's pointer when the survivor is deleted would strand a card
  /// that then resolves to a record with no history — which is the failure the
  /// column exists to prevent, arriving by a different door.
  mergedInto Patron? @relation("PatronMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom Patron[]    @relation("PatronMerge")

  cards         PatronCard[]
  identifiers   PatronIdentifier[]
  addresses     PatronAddress[]
  blocks        PatronBlock[]
  messages      PatronMessage[]
  notes         PatronNote[]
  relationsFrom PatronRelationship[] @relation("RelationshipFrom")
  relationsTo   PatronRelationship[] @relation("RelationshipTo")
  mergesAsLoser    PatronMerge[] @relation("MergeLoser")
  mergesAsSurvivor PatronMerge[] @relation("MergeSurvivor")

  @@index([patronCategoryId])
  @@index([sortName, id], map: "patrons_sort_name_id_idx")
  @@index([status])
  @@index([email])
  holds      Hold[]
  holdGroups HoldGroup[]

  @@map("patrons")
}

/// One copy, out to one borrower.
///
/// Fully specified by §3, and three of its decisions are corrections of real
/// 1.0 dead ends rather than preferences.
///
/// **`closed_at` is distinct from `returned_at`.** In 1.0 a `lost` loan keeps
/// `returned_at IS NULL` forever, so `loans_one_open_per_item` pins that copy out
/// of circulation permanently and a lost-then-found item can NEVER be returned
/// without violating the constraint. In 2.0 `lost` sets `closed_at` (the item is
/// gone, a fee stands) and `markFound` can later set `returned_at` on that closed
/// loan and issue a refund. `claims_returned` deliberately keeps the loan OPEN —
/// the copy is unaccounted for and must not be re-lendable.
///
/// **`patron_id` is NULLABLE because reading history is anonymised on return by
/// default.** It is nulled and `anonymised_at` stamped in the same transaction as
/// the return, and the statistical buckets below (`patron_category_code`,
/// `patron_age_band`, `patron_home_branch_id`) are retained so nothing downstream
/// changes. This is an IFLA/NISO professional obligation and the Greek DPA
/// answer, and it is a DEFAULT rather than a setting somebody forgot to turn on.
///
/// **`policy_snapshot` is the frozen resolution**, so editing a rule can never
/// retroactively re-price an open loan. Correcting a policy is an explicit,
/// audited `POST /circulation/loans/repolicy` that writes a `loan_event` per
/// loan — never a silent recompute.
/// @replicated entity_kind=loan
model Loan {
  id String @id @default(cuid())

  itemId String @map("item_id")
  /// NULL once anonymised. See the docblock.
  patronId      String?   @map("patron_id")
  anonymisedAt  DateTime? @db.Timestamptz(3) @map("anonymised_at")
  proxyPatronId String?   @map("proxy_patron_id")
  bibId         String    @map("bib_id")

  checkoutBranchId       String  @map("checkout_branch_id")
  checkoutServicePointId String? @map("checkout_service_point_id")
  checkedOutByUserId     String? @map("checked_out_by_user_id")

  loanedAt          DateTime  @default(now()) @db.Timestamptz(3) @map("loaned_at")
  dueAt             DateTime  @db.Timestamptz(3) @map("due_at")
  /// What the policy said at checkout, before any renewal or recall moved it.
  /// Renewal statistics and "was this loan ever extended?" both read it.
  originalDueAt     DateTime  @db.Timestamptz(3) @map("original_due_at")
  gracePeriodEndsAt DateTime? @db.Timestamptz(3) @map("grace_period_ends_at")

  returnedAt       DateTime? @db.Timestamptz(3) @map("returned_at")
  returnBranchId   String?   @map("return_branch_id")
  returnedByUserId String?   @map("returned_by_user_id")
  /// DISTINCT from `returned_at`. See the docblock.
  closedAt         DateTime? @db.Timestamptz(3) @map("closed_at")

  status LoanStatus @default(active)

  renewalCount        Int     @default(0) @map("renewal_count")
  autoRenewCount      Int     @default(0) @map("auto_renew_count")
  autoRenewFailReason String? @map("auto_renew_fail_reason")

  recalledAt       DateTime? @db.Timestamptz(3) @map("recalled_at")
  recallDueAt      DateTime? @db.Timestamptz(3) @map("recall_due_at")
  recalledByHoldId String?   @map("recalled_by_hold_id")

  declaredLostAt     DateTime? @db.Timestamptz(3) @map("declared_lost_at")
  claimedReturnedAt  DateTime? @db.Timestamptz(3) @map("claimed_returned_at")

  // -- POLICY PINNING --------------------------------------------------------
  // These six are `NOT NULL` and carry NO foreign key, exactly as §3 writes
  // them. That is not an oversight in either direction: the tables they name
  // (`loan_policies`, `overdue_fine_policies`, `lost_item_fee_policies`,
  // `circulation_rules`, `patron_categories`) are phase 9b/13, and a loan must
  // keep pointing at the rule that priced it even after that rule is archived.
  // An FK with ON DELETE RESTRICT would make a policy un-retirable for as long
  // as any historical loan referenced it, which for a public library is
  // forever.
  loanPolicyId            String @map("loan_policy_id")
  overdueFinePolicyId     String @map("overdue_fine_policy_id")
  lostItemFeePolicyId     String @map("lost_item_fee_policy_id")
  appliedRuleId           String @map("applied_rule_id")
  /// The resolved VALUES, frozen at checkout.
  policySnapshot          Json   @db.JsonB @map("policy_snapshot")
  itemTypeIdApplied       String @map("item_type_id_applied")
  patronCategoryIdApplied String @map("patron_category_id_applied")

  // -- statistical buckets that survive anonymisation -------------------------
  patronCategoryCode String? @map("patron_category_code")
  patronAgeBand      String? @map("patron_age_band")
  patronHomeBranchId String? @map("patron_home_branch_id")

  source EventSource @default(desk)

  deviceId       String? @map("device_id")
  /// The offline client's idempotency key. Paired with `sync_client_changes`,
  /// this is what makes a replayed checkout exactly-once rather than a duplicate
  /// loan.
  clientChangeId String? @db.Uuid @map("client_change_id")

  createdAt DateTime @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @map("updated_at")

  item   Item    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  patron Patron? @relation(fields: [patronId], references: [id], onDelete: Restrict)
  events LoanEvent[]

  /// NOT partial on `status`. A `WHERE status = 'active'` predicate cannot be
  /// used by the planner here for the enum-cast reason recorded on `Item` —
  /// which is the mistake `loans_active_dueAt_idx` made in 1.0.
  @@index([status, dueAt, id], map: "loans_status_due_id_idx")
  @@index([bibId])
  @@map("loans")
}
