// ---------------------------------------------------------------------------
// The MARC store — the system of record
// ---------------------------------------------------------------------------
//
// Three tables, deliberately. Identity is narrow and hot; the document is 1:1
// beside it and never selected by accident; versions are append-only full
// snapshots.
//
// The 1:1 split is not tidiness. TOAST keeps a fat jsonb off the heap page only
// PROVIDED NOTHING SELECTS IT, and Prisma's default `findMany` selects every
// scalar column of a model. Putting `content` on `marc_records` would mean every
// facet count, every OPAC list and every report drags 1.6 KB of document per row
// through the buffer cache. As two models it is unrepresentable: you cannot
// accidentally select a column that belongs to a table you did not join, and
// `source_blob bytea` stays out of `SELECT *` forever.
//
// Ordinary reads never touch either satellite. Facets, reports, the OPAC and the
// search indexer all read the relational projection (phase 11), which is why a
// 5M-record catalogue can be indexed without the document being read at all.

/// A MARC record's identity. Narrow, hot, never carries the document.
///
/// `content_hash` is sha256 over the canonical NFC JSON EXCLUDING field 005,
/// because 005 is the transaction timestamp and including it would make every
/// record differ from itself. It is the optimistic-concurrency token phase 10's
/// `write()` takes as a precondition.
/// @replicated entity_kind=marc_record
model MarcRecord {
  id String @id @default(cuid())

  /// Per-tenant monotonic, and the number a librarian actually reads out over
  /// the phone. Distinct from `id` on purpose: a cuid is unspeakable.
  ///
  /// Minted by a sequence rather than a counter row — see the phase-10
  /// migration for why the patron-number rule does not apply here. Gaps on a
  /// rolled-back create are accepted: this is an identifier, not a count.
  publicNo BigInt @unique @default(dbgenerated("nextval('marc_public_no_seq'::regclass)")) @map("public_no")

  kind   MarcRecordKind
  schema MarcSchema
  status MarcRecordStatus

  leader String @db.Char(24)

  /// sha256 over canonical NFC JSON, EXCLUDING 005. 32 bytes, CHECKed.
  contentHash    Bytes @map("content_hash")
  currentVersion Int   @default(1) @map("current_version")

  /// The total order every replica and index reads the feed in. Drawn from
  /// `record_version_seq`, which `change_events.row_version` also draws from, so
  /// a device can order a record change against a loan change.
  rowVersion BigInt @default(dbgenerated("nextval('record_version_seq'::regclass)")) @map("row_version")

  /// Leader/05, DERIVED from `status` rather than stored independently. Two
  /// places holding the same fact is two places to disagree.
  recordStatusCode String  @db.Char(1) @map("record_status_code")
  recordTypeCode   String? @db.Char(1) @map("record_type_code")
  bibLevelCode     String? @db.Char(1) @map("bib_level_code")
  encodingLevel    String? @db.Char(1) @map("encoding_level")

  /// Leader/09. `' '` is MARC-8, `'a'` is UCS/Unicode. Set from the EXPORT
  /// encoding on write, never copied from the source: a UTF-8 record emitted
  /// with a blank /09 is mojibake at the far end.
  charsetCode String @default("a") @db.Char(1) @map("charset_code")

  controlNumber       String? @map("control_number")
  controlNumberSource String? @map("control_number_source")

  /// 008/00-05, derived from `created_at` and NEVER rewritten. Every "titles
  /// added this year" statistic and the ISO 2789 return depend on that.
  dateEntered String? @db.Char(6) @map("date_entered")

  /// Set when this record loses a merge. The survivor keeps its own id, so every
  /// permalink, hold and audit target pointing at the loser still resolves.
  mergedIntoId String? @map("merged_into_id")

  needsReview Boolean @default(false) @map("needs_review")

  /// Control-plane cuids. No FK, by house rule — there is no cross-database
  /// referential integrity and pretending otherwise is how a tenant restore
  /// fails.
  createdByUserId String? @map("created_by_user_id")
  updatedByUserId String? @map("updated_by_user_id")

  createdAt DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime  @db.Timestamptz(3) @map("updated_at")
  deletedAt DateTime? @db.Timestamptz(3) @map("deleted_at")

  mergedInto MarcRecord?  @relation("MarcRecordMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom MarcRecord[] @relation("MarcRecordMerge")

  content  MarcRecordContent?
  versions MarcRecordVersion[]
  items    Item[]
  /// At most one, and it is advisory: nothing in the write path reads it.
  lock     MarcRecordLock?

  @@index([kind, status, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([kind, recordTypeCode, bibLevelCode], map: "marc_records_type_idx")
  @@index([rowVersion], map: "marc_records_row_version_idx")
  @@map("marc_records")
}

/// The document. Deliberately 1:1, deliberately not a column on `marc_records`.
model MarcRecordContent {
  recordId String @id @map("record_id")

  /// A compact superset of MARC-in-JSON: an ORDERED array of fields, each
  /// `{t, v}` or `{t, i, s}`, where `s` is an ordered array of single-key
  /// objects. A map would silently destroy repeated subfields and subfield
  /// order, which is most of what a MARC record is.
  content Json @db.JsonB

  sourceFormat        MarcSourceFormat @map("source_format")
  sourceEncoding      String?          @map("source_encoding")
  sourceNormalization String?          @map("source_normalization")

  /// The ORIGINAL BYTES, verbatim, so an unedited imported record re-exports
  /// exactly what arrived. NULLed on first edit, because after an edit the
  /// promise is round-trip idempotence, not byte identity, and keeping stale
  /// bytes would let `?fidelity=source` serve a record that no longer exists.
  sourceBlob       Bytes?  @map("source_blob")
  sourceBlobSha256 Bytes?  @map("source_blob_sha256")
  /// Whether `serialize(parse(blob)) === blob` held at import. Recorded rather
  /// than assumed: it is false for a real fraction of real exporters, and a
  /// library is entitled to know which of its records are affected.
  sourceRoundtrips Boolean @default(true) @map("source_roundtrips")

  /// What the reader had to tolerate — `packages/marc`'s anomaly slugs.
  anomalies Json @default("[]") @db.JsonB

  updatedAt DateTime @db.Timestamptz(3) @map("updated_at")

  record MarcRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@map("marc_record_contents")
}

/// Append-only full snapshots.
///
/// Snapshots, not a diff chain. A record averages 1.6 KB and LZ4-compresses
/// about 4:1, so the storage argument for a chain is weak; and "restore version
/// N" becomes a copy rather than a replay, which cannot be subtly wrong the way
/// a replay can. A corrupted link in a chain silently corrupts every version
/// after it and nothing detects that until someone restores.
///
/// `bigserial`, not a cuid: high-volume, ordered, never user-facing.
model MarcRecordVersion {
  id       BigInt @id @default(autoincrement())
  recordId String @map("record_id")
  version  Int

  leader      String @db.Char(24)
  content     Json   @db.JsonB
  contentHash Bytes  @map("content_hash")

  changeKind    MarcChangeKind @map("change_kind")
  changeSummary String?        @map("change_summary")
  /// Which tags this version touched, so the version list can say "245, 650"
  /// without diffing two documents to render one row.
  changedTags   String[]       @default([]) @map("changed_tags")
  batchJobId    String?        @map("batch_job_id")

  actorKind AuditActorKind @map("actor_kind")
  actorId   String?        @map("actor_id")
  createdAt DateTime       @default(now()) @db.Timestamptz(3) @map("created_at")

  record MarcRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, version], map: "marc_record_versions_key")
  /// The 409 path: recover the document a stale caller was holding, from the
  /// only thing it sends about it — `expectedContentHash`.
  @@index([recordId, contentHash], map: "marc_record_versions_hash_idx")
  @@index([recordId, version(sort: Desc)], map: "marc_record_versions_desc_idx")
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "marc_record_versions_sweep_idx")
  @@map("marc_record_versions")
}

/// A cataloguer's claim on a record they have open in the editor.
///
/// §3 names this table in one list and specifies no column of it anywhere in
/// 1,054 lines, so every column below is either forced by phase 10's acceptance
/// criterion ("lock acquire/heartbeat/expiry/take-over each write the expected
/// audit action"), forced by a foreign key, or forced by a measurement. The
/// three that were considered and REJECTED are recorded at the bottom, because
/// a column nobody asked for is the expensive kind of guess in a schema.
///
/// ## This is not a database lock, and it must never gate a write
///
/// The write path has its own two mechanisms — an advisory lock for the
/// milliseconds of the save, and a content-hash compare-and-swap for staleness.
/// This is a third thing at a different timescale: a HUMAN's intent to hold a
/// record open for ten minutes, which has to survive a connection drop, be
/// visible to another person's SELECT, and be taken over.
///
/// `BibWriteService.write()` does not read it and must not learn to: an import,
/// an overlay, a merge, a batch job and the phase-19 copy-forward all have to be
/// able to write a record a cataloguer has open. In 10b the lock is ADVISORY —
/// it tells the editor whom to name in a banner, and nothing refuses a save.
/// Measured, the foreign key cannot gate it either by accident: an uncommitted
/// lock INSERT does not block the write path's UPDATE, because the acquire holds
/// KEY SHARE on `marc_records` while the write takes FOR NO KEY UPDATE, and
/// those do not conflict.
///
/// ## One row per record, and why the liveness is not in an index
///
/// `record_id` is the PRIMARY KEY, so "one lock per record" is structural and a
/// take-over is a single upsert rather than a delete-then-insert with a window
/// in the middle. The obvious alternative — many rows plus
/// `CREATE UNIQUE INDEX … WHERE expires_at > now()` — is refused by Postgres:
///
///     ERROR:  42P17: functions in index predicate must be marked IMMUTABLE
///
/// So the uniqueness lives in the key and the LIVENESS lives in the acquire
/// predicate, which compares a stored instant. That is also why a stopped sweep
/// can never freeze a record: expiry is evaluated on every acquire, not by a job.
///
/// ## No `@replicated` marker, deliberately
///
/// A lock beats every sixty seconds while an editor is open. Replicating it
/// would make it the largest producer in the change feed, to tell consumers
/// about something no consumer wants: the OPAC does not care who is typing, and
/// an offline replica must not inherit a lock it cannot heartbeat.
/// `check:changelog-coverage` enforces both directions against the committed
/// SQL, so the absence of a marker AND of a trigger is a checked decision rather
/// than an omission.
model MarcRecordLock {
  /// FORCED, three ways: it is the FK target, it is the uniqueness, and making
  /// it the key is what lets take-over be one statement.
  recordId String @id @map("record_id")

  /// FORCED by the criterion — take-over must name a victim, and all four audit
  /// actions must name a subject.
  ///
  /// A bare control-plane cuid with NO foreign key, by the house rule that
  /// applies to every actor id in a tenant database: there is no cross-database
  /// referential integrity, and pretending otherwise is how a restore fails.
  holderUserId String @map("holder_user_id")

  /// FORCED BY MEASUREMENT, and it is the single strongest result in this phase.
  ///
  /// With the guard on `holder_user_id` alone, 25 contenders who are all the
  /// SAME PERSON in 25 different browser tabs, racing a live lock held by that
  /// person's first tab: **25 winners, 0 refused**. Every tab silently inherits
  /// the lock, and the cataloguer loses her work the first time she opens a
  /// second one. With `session_id` in the guard: 0 winners, 25 refused.
  ///
  /// A lock is held by a TAB, not by a person.
  sessionId String @map("session_id")

  /// FORCED by what the audit row and the refused caller must say: how long the
  /// incumbent has held it. Not derivable from `expires_at` once a heartbeat has
  /// moved it.
  acquiredAt DateTime @default(now()) @db.Timestamptz(3) @map("acquired_at")

  /// FORCED. Since liveness cannot be an index predicate (42P17 above), it must
  /// be a stored instant the acquire predicate compares. Measured sufficient on
  /// its own for correctness with no sweep in the database at all.
  expiresAt DateTime @db.Timestamptz(3) @map("expires_at")

  /// FORCED, and the pair that keeps clause 5's four actions distinguishable.
  ///
  /// The upsert that acquires is also the upsert that displaces, so the row it
  /// returns has to say WHOM it displaced and WHY — otherwise the caller cannot
  /// tell whether it just wrote `lock_expired` or `lock_taken_over`, and the two
  /// become one indistinguishable event.
  displacedHolderUserId String? @map("displaced_holder_user_id")
  /// `expired` | `taken_over`, CHECKed in the migration.
  displacedReason       String? @map("displaced_reason")

  /// INVENTED, and it earns its place by serving the word "heartbeat" in the
  /// acceptance criterion at a bounded cost.
  ///
  /// The audit row is written only on the FIRST beat of a session (count 1), not
  /// on every one: a heartbeat is ~0.12 ms and beats every 60 s, so auditing all
  /// of them would write ten permanent rows per record per session to record
  /// that somebody left a tab open. The counter is what makes "first beat" a
  /// question the database can answer without a second read.
  heartbeatCount Int @default(0) @map("heartbeat_count")

  record MarcRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  // REJECTED, each for a stated reason, so the next person does not re-propose
  // them:
  //
  //   heartbeat_at / last_seen_at — the same fact twice. `expires_at` minus the
  //     TTL IS the last beat, always, because every heartbeat writes both.
  //   holder_name — the house pattern for turning an actor id into a display
  //     name is read-time batch resolution against the control database
  //     (`AuditService` already does exactly this), not denormalisation that
  //     goes stale the first time somebody marries.
  //   taken_over_at — equals `acquired_at` of the row that did the taking; the
  //     same statement sets both.
  //   released_at — release is a DELETE. A soft-delete column would turn a
  //     one-row-per-record table into an append log and reopen the uniqueness
  //     question that 42P17 proves an index cannot answer.
  //   branch_id / device_id / ip_address / lock_reason — speculative. None is
  //     asked for by the criterion, by a foreign key or by a measurement. Device
  //     attribution is M8.
  //   an index on expires_at — measured to cost HOT updates (100% → 87.2% over
  //     3,000 heartbeats), and the table is bounded at one row per record ever
  //     opened. Add it when a sweep is measured slow, not before.
  @@map("marc_record_locks")
}
