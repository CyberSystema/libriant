// ---------------------------------------------------------------------------
// Patrons (members)
// ---------------------------------------------------------------------------

model Member {
  id            String       @id @default(cuid())
  /// Human-readable membership identifier ("M-2026-0001"). Unique within
  /// the library among non-archived members.
  memberNumber  String
  fullName      String
  /// Lowercased + accent-folded, used for sorting.
  sortName      String
  /// Lowercased + accent-folded composite of name + email + member_number
  /// + phone for fuzzy search (GIN trigram index).
  searchText    String
  email         String?      @db.Citext
  phone         String?
  dateOfBirth   DateTime?    @db.Date
  /// Postal address.
  addressLine1  String?
  addressLine2  String?
  city          String?
  postalCode    String?
  country       String?
  /// Asset slot or storage URL for the member's photo (see `book.coverAssetRef`).
  photoAssetRef String?
  status        MemberStatus @default(active)
  /// Notes visible to library staff (not to the member).
  staffNotes    String?
  joinedAt      DateTime     @default(now())
  customFields  Json         @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  archivedAt    DateTime?
  /// Set by `MembersService.erase()` (GDPR Art. 17). When non-NULL every
  /// direct identifier above has been overwritten with a tombstone and this
  /// row exists ONLY to keep the loan/fine foreign keys resolvable — see the
  /// long comment on `erase()` for what deliberately survives and why.
  /// NEVER re-populate an erased row: restoring identifiers would undo an
  /// exercised erasure right.
  erasedAt      DateTime?

  loans        Loan[]
  reservations Reservation[]
  fines        Fine[]

  @@index([sortName, id], map: "members_sortName_id_idx")
  @@index([status])
  @@index([email])
  // `members_member_number_pattern_idx` (btree, text_pattern_ops) is added in
  // the migration SQL, not here: Prisma cannot express a btree operator class.
  // It exists because the tenant databases are created with the server's
  // el_GR.UTF-8 collation (infra/compose/docker-compose.prod.yml sets
  // `LANG: el_GR.UTF-8`), and under a non-C collation a DEFAULT btree is
  // unusable for `LIKE 'M-2026-%'` — the seed scan in member-numbers.ts, and
  // the importer's `memberNumber` equality lookups, both seq-scanned (perf-04,
  // and the collation trap is perf-13).
  @@map("members")
}

/// One row per calendar year, per library: the next free auto-generated
/// member-number sequence.
///
/// perf-04: member numbers used to be minted by pulling EVERY member number
/// for the year into Node and taking the max — a full table scan per create,
/// which made a roster import O(n^2) and left a 100k-row import unfinishable.
/// `UPDATE … RETURNING` on this single row is O(1) and, because the update
/// takes a row lock, it also HANDS OUT EACH NUMBER ONCE instead of relying on
/// the caller's retry loop to clean up races.
///
/// The counter is lazily seeded from `max(memberNumber)` the first time a year
/// is used (see `nextSequenceForYear`), so an existing library never re-issues
/// a number it has already printed on a card.
model MemberNumberCounter {
  /// Calendar year the sequence belongs to (the `YYYY` in `M-YYYY-NNNN`).
  year    Int @id
  /// Last sequence handed out. The next caller gets `nextSeq + 1`.
  nextSeq Int

  @@map("member_number_counters")
}
