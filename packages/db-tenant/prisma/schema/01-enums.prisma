enum BookCopyStatus {
  available
  on_loan
  reserved
  lost
  damaged
  withdrawn
}

enum MemberStatus {
  active
  suspended
  archived
}

enum LoanStatus {
  active
  returned
  lost
}

enum ReservationStatus {
  queued
  ready
  fulfilled
  expired
  canceled
}

enum FineStatus {
  outstanding
  paid
