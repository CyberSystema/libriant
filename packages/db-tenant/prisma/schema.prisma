// Libriant — Tenant schema.
//
// One database per library. Identical schema across all tenants. Holds the
// library's catalog (books, copies, authors), patrons (members), circulation
// (loans, reservations, fines), the customization layer (field definitions
// per entity + custom collections), tenant-side audit log, and per-tenant
// settings.
//
// Design principles enforced here:
//   - Strict isolation: there are NO foreign keys to the control plane.
//     Cross-DB references (e.g. who created what) are stored as text cuids
//     and joined in the application layer when needed.
//   - Every customizable built-in entity (book / book_copy / member / loan /
//     reservation / fine) has a `customFields Json` column with a GIN index.
//     Per-tenant schema metadata lives in `field_definitions`.
//   - "Custom entity types" (DVDs, BoardGames, Events) are modeled as
//     `collections` + `collection_records` so a new entity type is data, not
//     DDL.
//   - Soft-delete via `archivedAt DateTime?` on everything a user could
//     legitimately want to restore from a 30-day undo bucket. Hard delete is
//     reserved for ephemeral data (audit log retention is enforced by a job,
//     not by the schema).
//   - Greek-aware search/sort: every searchable entity has a `searchText`
//     column (lowercased + accent-folded by the app) with a GIN trigram
//     index. Sort columns are similarly normalized.
//   - DB-level invariants:
//       * at most one active loan per copy
//       * at most one active reservation per (book, member)
//       * barcodes / member numbers unique among non-archived rows
//       * all monetary amounts non-negative
//       * dates respect chronology (due_at > loaned_at, etc.)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../node_modules/.prisma/tenant-client"
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, citext, pg_trgm, unaccent]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum BookCopyStatus {
  available
  on_loan
  reserved
  lost
  damaged
  withdrawn
}

enum MemberStatus {
  active
  suspended
  archived
}

enum LoanStatus {
  active
  returned
  lost
}

enum ReservationStatus {
  queued
  ready
  fulfilled
  expired
  canceled
}

enum FineStatus {
  outstanding
  paid
  waived
}

enum AuditActorType {
  user
  admin
  system
}

/// What built-in entity a custom field is attached to.
enum FieldEntityKind {
  book
  book_copy
  member
  loan
  reservation
  fine
}

/// Plain-language field types exposed in the schema editor. Values are
/// validated in the application layer against `optionsJson` /
/// `validationJson`.
enum FieldType {
  short_text
  long_text
  number
  boolean
  date
  datetime
  select_one
  select_many
  url
  email
}

// ---------------------------------------------------------------------------
// Tenant settings — single-row table with the library's default circulation
// policy (loan period, fines, hold expiry, etc.). The seed script ensures
// row id = 1 always exists.
// ---------------------------------------------------------------------------

model TenantSetting {
  /// Always 1. Enforced by a CHECK constraint.
  id              Int      @id @default(1)
  /// ISO 4217 currency for fines.
  currency        String   @default("EUR")
  /// Default lending period in days.
  loanPeriodDays  Int      @default(14)
  /// Maximum number of times a member can renew an active loan.
  maxRenewals     Int      @default(2)
  /// Fine accrued per overdue day, in subunits of the currency (e.g. cents).
  finePerDayCents Int      @default(0)
  /// Maximum cap on a single fine; 0 = uncapped.
  fineCapCents    Int      @default(0)
  /// After a reservation becomes "ready for pickup", how many hours the
  /// member has before it expires and the next person in the queue gets it.
  holdPickupHours Int      @default(48)
  /// Maximum simultaneous active loans per member; 0 = uncapped.
  maxActiveLoans  Int      @default(0)
  /// Default locale for the library — kept here as well as in the control
  /// plane so reports / emails generated tenant-side can localize even when
  /// no control-plane lookup is convenient.
  defaultLocale   String   @default("el")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("tenant_settings")
}

// ---------------------------------------------------------------------------
// Catalog: authors, books, copies
// ---------------------------------------------------------------------------

/// An author or other creator (translator, illustrator) referenced by books.
/// Many books can share one author; one book can have many (book_authors).
model Author {
  id             String    @id @default(cuid())
  /// Display name as it appears on book covers (e.g. "Νίκος Καζαντζάκης").
  fullName       String
  /// Sortable, accent-folded, lowercase form (app maintains).
  sortName       String
  /// Some authors are known by a single mononym.
  isOrganization Boolean   @default(false)
  birthYear      Int?
  deathYear      Int?
  /// Free-form note (notes on translations, pen names, etc.).
  notes          String?
  customFields   Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  bookLinks BookAuthor[]

  @@index([sortName])
  @@map("authors")
}

/// A bibliographic record (one row per work/edition the library catalogs).
/// Physical copies are tracked in `book_copies`.
model Book {
  id              String    @id @default(cuid())
  title           String
  subtitle        String?
  /// Lowercased + accent-folded title used for sorting.
  sortTitle       String
  /// Concatenated title + subtitle + authors + publisher + isbn, lowercased
  /// and accent-folded, used for fuzzy search (GIN trigram index).
  searchText      String
  /// ISBN-13 with hyphens stripped. Stored even when missing for old books.
  isbn13          String?
  /// Legacy ISBN-10, also normalized.
  isbn10          String?
  publisher       String?
  publicationYear Int?
  /// BCP-47 language tag of the book's content (e.g. "el", "en-US").
  language        String?
  edition         String?
  numPages        Int?
  description     String?
  /// Slot name in the asset manifest (e.g. "covers/placeholder-book") OR
  /// a storage-driver URL ("file://covers/<id>.jpg"). The storage layer
  /// resolves on read.
  coverAssetRef   String?
  /// Free-form classification (Dewey, BISAC, library-specific shelf code).
  classification  String?
  customFields    Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?

  authors      BookAuthor[]
  copies       BookCopy[]
  reservations Reservation[]

  @@index([sortTitle])
  @@index([isbn13])
  @@index([isbn10])
  @@index([publicationYear])
  @@map("books")
}

/// Join table: ordered list of authors for a book (so "Author 1, Author 2"
/// renders in the right order).
model BookAuthor {
  bookId   String
  authorId String
  /// Position in the author list (0-based).
  order    Int     @default(0)
  /// Optional role override (e.g. "translator", "illustrator"). Left null
  /// for the primary author(s).
  role     String?

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@id([bookId, authorId])
  @@index([authorId])
  @@map("book_authors")
}

/// A physical copy of a book — what librarians actually circulate. Multiple
/// copies of the same Book are typical.
model BookCopy {
  id             String         @id @default(cuid())
  bookId         String
  /// Barcode printed on the physical copy. Unique within the library among
  /// non-archived copies (partial unique index in migration SQL).
  barcode        String
  status         BookCopyStatus @default(available)
  /// Where the copy lives in the library ("Section A, Shelf 3").
  shelfLocation  String?
  conditionNotes String?
  acquiredAt     DateTime?
  /// Acquisition cost in subunits (e.g. cents). NULL if unknown.
  priceCents     Int?
  customFields   Json           @default("{}")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  archivedAt     DateTime?

  book           Book          @relation(fields: [bookId], references: [id], onDelete: Restrict)
  loans          Loan[]
  fulfilledHolds Reservation[] @relation("ReservationFulfilledByCopy")

  @@index([bookId, status])
  @@index([status])
  @@map("book_copies")
}

// ---------------------------------------------------------------------------
// Patrons (members)
// ---------------------------------------------------------------------------

model Member {
  id            String       @id @default(cuid())
  /// Human-readable membership identifier ("M-2026-0001"). Unique within
  /// the library among non-archived members.
  memberNumber  String
  fullName      String
  /// Lowercased + accent-folded, used for sorting.
  sortName      String
  /// Lowercased + accent-folded composite of name + email + member_number
  /// + phone for fuzzy search (GIN trigram index).
  searchText    String
  email         String?      @db.Citext
  phone         String?
  dateOfBirth   DateTime?    @db.Date
  /// Postal address.
  addressLine1  String?
  addressLine2  String?
  city          String?
  postalCode    String?
  country       String?
  /// Asset slot or storage URL for the member's photo (see `book.coverAssetRef`).
  photoAssetRef String?
  status        MemberStatus @default(active)
  /// Notes visible to library staff (not to the member).
  staffNotes    String?
  joinedAt      DateTime     @default(now())
  customFields  Json         @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  archivedAt    DateTime?

  loans        Loan[]
  reservations Reservation[]
  fines        Fine[]

  @@index([sortName])
  @@index([status])
  @@index([email])
  @@map("members")
}

// ---------------------------------------------------------------------------
// Circulation: loans, reservations, fines
// ---------------------------------------------------------------------------

model Loan {
  id                 String     @id @default(cuid())
  copyId             String
  memberId           String
  loanedAt           DateTime   @default(now())
  /// When the book is due back.
  dueAt              DateTime
  /// NULL while the loan is active. When set, the loan is closed.
  returnedAt         DateTime?
  /// How many times the loan has been renewed.
  renewedCount       Int        @default(0)
  status             LoanStatus @default(active)
  /// Free-form note (damage on return, lost report, etc.).
  notes              String?
  /// The staff user (control-plane User.id) who checked out the loan.
  checkedOutByUserId String?
  /// The staff user who processed the return.
  returnedByUserId   String?
  customFields       Json       @default("{}")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  copy   BookCopy @relation(fields: [copyId], references: [id], onDelete: Restrict)
  member Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  fines  Fine[]

  @@index([memberId, status])
  @@index([copyId])
  @@index([dueAt])
  @@index([returnedAt])
  @@map("loans")
}

model Reservation {
  id                String            @id @default(cuid())
  /// Reservations are placed against a Book (any copy will satisfy them),
  /// not a specific BookCopy.
  bookId            String
  memberId          String
  placedAt          DateTime          @default(now())
  /// 1-based position in the queue. NULL once the reservation is no longer
  /// queued (i.e. ready/fulfilled/expired/canceled).
  queuePosition     Int?
  status            ReservationStatus @default(queued)
  /// When the reservation transitioned to `ready` (notification sent).
  readyAt           DateTime?
  /// After which the member loses their slot if they haven't picked up.
  expiresAt         DateTime?
  /// When the reservation was satisfied by a checkout.
  fulfilledAt       DateTime?
  /// Which physical copy was used to fulfill.
  fulfilledByCopyId String?
  canceledAt        DateTime?
  notes             String?
  placedByUserId    String?
  customFields      Json              @default("{}")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  book            Book      @relation(fields: [bookId], references: [id], onDelete: Restrict)
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  fulfilledByCopy BookCopy? @relation("ReservationFulfilledByCopy", fields: [fulfilledByCopyId], references: [id], onDelete: SetNull)

  @@index([bookId, status, queuePosition])
  @@index([memberId, status])
  @@index([expiresAt])
  @@map("reservations")
}

model Fine {
  id               String     @id @default(cuid())
  memberId         String
  /// Loan that generated this fine. NULL for ad-hoc fines (lost-book
  /// replacement, damage, etc.).
  loanId           String?
  /// Amount in subunits of the tenant's currency.
  amountCents      Int
  currency         String     @default("EUR")
  reason           String
  status           FineStatus @default(outstanding)
  paidAt           DateTime?
  /// The staff user who recorded the payment / waiver.
  resolvedByUserId String?
  notes            String?
  customFields     Json       @default("{}")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  archivedAt       DateTime?

  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  loan   Loan?  @relation(fields: [loanId], references: [id], onDelete: SetNull)

  @@index([memberId, status])
  @@index([loanId])
  @@map("fines")
}

// ---------------------------------------------------------------------------
// Schema customization — Layer 1: custom fields on built-in entities.
// ---------------------------------------------------------------------------

/// One row per custom field a library has defined for a built-in entity.
/// The matching value lives inside that entity's `customFields` JSONB. The
/// application layer validates writes against this row; the DB just stores.
model FieldDefinition {
  id             String          @id @default(cuid())
  /// Which built-in entity this field attaches to.
  entityKind     FieldEntityKind
  /// Snake-case key used inside `customFields` JSONB.
  fieldKey       String
  /// `{ "en": "Shelf section", "el": "Τομέας ραφιού" }`.
  labelJson      Json
  type           FieldType
  required       Boolean         @default(false)
  /// `{ "options": [{ "value": "fiction", "label": { "en": "Fiction", "el": "Λογοτεχνία" } }] }`
  /// for select_one / select_many. NULL otherwise.
  optionsJson    Json?
  /// `{ "min": 0, "max": 999, "pattern": "...", "minLength": ..., "maxLength": ... }` etc.
  validationJson Json?
  /// Display order within the entity's edit form.
  sortOrder      Int             @default(0)
  /// Forward-compat hook: when true, the application MAY promote this field
  /// to a generated typed column for faster filtering. No-op at MVP.
  indexed        Boolean         @default(false)
  /// Hide from new records without losing existing data.
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([entityKind, fieldKey])
  @@index([entityKind, sortOrder])
  @@map("field_definitions")
}

// ---------------------------------------------------------------------------
// Schema customization — Layer 2: custom entity types ("collections").
// A library can define new entities (DVDs, BoardGames, Events) entirely in
// data. Each collection has its own field schema and records.
// ---------------------------------------------------------------------------

model Collection {
  id                String    @id @default(cuid())
  /// URL-safe identifier ("dvds", "events"). Unique within the library
  /// among non-archived collections.
  slug              String
  /// `{ "en": "DVD", "el": "DVD" }`.
  singularLabelJson Json
  /// `{ "en": "DVDs", "el": "DVDs" }`.
  pluralLabelJson   Json
  /// Asset slot for the collection's icon (e.g. "icons/book").
  iconAssetRef      String?
  sortOrder         Int       @default(0)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  fields  CollectionField[]
  records CollectionRecord[]

  @@index([slug])
  @@map("collections")
}

model CollectionField {
  id             String    @id @default(cuid())
  collectionId   String
  fieldKey       String
  labelJson      Json
  type           FieldType
  required       Boolean   @default(false)
  optionsJson    Json?
  validationJson Json?
  sortOrder      Int       @default(0)
  indexed        Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, fieldKey])
  @@index([collectionId, sortOrder])
  @@map("collection_fields")
}

model CollectionRecord {
  id              String    @id @default(cuid())
  collectionId    String
  /// All field values for this record, keyed by `field_key`.
  data            Json      @default("{}")
  /// Lowercased + accent-folded concat of selected string fields, used for
  /// fuzzy search. App maintains.
  searchText      String    @default("")
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, createdAt])
  @@index([collectionId, archivedAt])
  @@map("collection_records")
}

// ---------------------------------------------------------------------------
// Audit log — tenant-side, library-visible. Records every meaningful change
// in this library's data. Retention is governed by the tenant's plan
// (`audit_log_retention_days` feature) and enforced by a background job.
// ---------------------------------------------------------------------------

model AuditEvent {
  id               String         @id @default(cuid())
  /// `user`, `admin`, or `system`. Admin entries are written ONLY during
  /// an active support session (see `supportSessionId`).
  actorType        AuditActorType
  /// CUID from the control plane; resolved on read in the API layer.
  actorId          String?
  /// e.g. `book.created`, `loan.checked_out`, `member.archived`,
  /// `custom_field.created`, `support.action`.
  action           String
  targetType       String?
  targetId         String?
  beforeJson       Json?
  afterJson        Json?
  ip               String?
  userAgent        String?
  /// When set, the action happened during a Libriant support impersonation
  /// session. The id matches a `support_sessions.id` in the control plane.
  supportSessionId String?
  occurredAt       DateTime       @default(now())

  @@index([occurredAt])
  @@index([actorType, actorId, occurredAt])
  @@index([targetType, targetId])
  @@index([action, occurredAt])
  @@index([supportSessionId])
  @@map("audit_log")
}
