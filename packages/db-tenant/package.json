{
  "name": "@libriant/db-tenant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./upgrade/marc-from-book": "./src/upgrade/marc-from-book.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "echo 'lint: ok'",
    "prisma:generate": "prisma generate && prisma generate --config prisma-v2.config.ts",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate && prisma validate --config prisma-v2.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:deploy:v2": "prisma migrate deploy --config prisma-v2.config.ts",
    "prisma:studio": "prisma studio",
    "seed:defaults": "tsx prisma/seed-defaults.ts",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@libriant/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
