{
  "name": "libriant",
  "version": "0.1.0",
  "private": true,
  "description": "Libriant — multi-tenant SaaS for library management",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check:translations": "tsx scripts/check-translations.ts",
    "check:assets": "tsx scripts/check-assets.ts",
    "check:all": "pnpm check:translations && pnpm check:assets && pnpm typecheck && pnpm lint",
    "db:up": "docker compose -f infra/compose/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f infra/compose/docker-compose.dev.yml down",
    "db:logs": "docker compose -f infra/compose/docker-compose.dev.yml logs -f",
    "db:psql": "PGPASSWORD=libriant docker exec -it libriant-postgres psql -U libriant -d libriant_control",
    "db:generate": "pnpm --filter @libriant/db-control prisma:generate && pnpm --filter @libriant/db-tenant prisma:generate",
    "db:migrate:deploy": "pnpm --filter @libriant/db-control prisma:migrate:deploy",
    "db:seed": "pnpm --filter @libriant/db-control seed",
    "ingest:help": "tsx scripts/ingest-help-articles.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "db:studio": "pnpm --filter @libriant/db-control prisma:studio",
    "db:reset": "pnpm --filter @libriant/db-control prisma:migrate:reset",
    "tenant:migrate:deploy": "pnpm --filter @libriant/db-tenant prisma:migrate:deploy",
    "tenant:seed:defaults": "pnpm --filter @libriant/db-tenant seed:defaults",
    "tenant:smoke": "pnpm --filter @libriant/db-tenant smoke",
    "tenant:create": "tsx scripts/tenant-create.ts",
    "tenant:migrate": "tsx scripts/tenant-migrate.ts",
    "tenant:relocate": "tsx scripts/tenant-relocate.ts",
    "storage:migrate": "tsx scripts/storage-migrate.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "marked": "^18.0.4",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "^5.11.0"
    }
  }
}
