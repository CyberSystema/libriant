{
  "name": "libriant",
  "version": "0.1.0",
  "private": true,
  "description": "Libriant \u2014 multi-tenant SaaS for library management",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings 0",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check:translations": "tsx scripts/check-translations.ts",
    "check:assets": "tsx scripts/check-assets.ts",
    "check:pnpm-pins": "node scripts/check-pnpm-pins.mjs && node scripts/check-supply-chain.mjs",
    "check:supply-chain": "node scripts/check-supply-chain.mjs",
    "check:legal": "node scripts/check-legal-docs.mjs",
    "check:caddy": "node scripts/check-caddy.mjs",
    "check:alerts": "tsx scripts/check-alerts.ts",
    "check:shared-imports": "node scripts/check-shared-imports.mjs",
    "check:countries": "node scripts/check-countries.mjs",
    "check:greek-folding": "tsx scripts/check-greek-folding.ts",
    "check:currencies": "tsx scripts/check-currencies.ts",
    "check:migration-safety": "tsx scripts/check-migration-safety.ts",
    "check:permissions": "tsx scripts/check-permissions.ts",
    "check:tenant-db-urls": "tsx scripts/check-tenant-db-urls.ts",
    "check:openapi": "tsx --tsconfig apps/api/tsconfig.json scripts/check-openapi.ts",
    "marc8:tables": "tsx scripts/gen-marc8-tables.ts",
    "check:schema-drift": "tsx scripts/check-schema-drift.ts",
    "check:image-size": "node scripts/check-image-size.mjs",
    "check:all": "pnpm check:translations && pnpm check:assets && pnpm check:pnpm-pins && pnpm check:supply-chain && pnpm check:legal && pnpm check:caddy && pnpm check:alerts && pnpm check:shared-imports && pnpm check:countries && pnpm check:greek-folding && pnpm check:currencies && pnpm check:migration-safety && pnpm check:permissions && pnpm check:tenant-db-urls && pnpm check:openapi && pnpm typecheck && pnpm lint",
    "db:up": "docker compose -f infra/compose/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f infra/compose/docker-compose.dev.yml down",
    "db:logs": "docker compose -f infra/compose/docker-compose.dev.yml logs -f",
    "db:psql": "PGPASSWORD=libriant docker exec -it libriant-postgres psql -U libriant -d libriant_control",
    "db:generate": "pnpm --filter @libriant/db-control prisma:generate && pnpm --filter @libriant/db-tenant prisma:generate",
    "db:migrate:deploy": "pnpm --filter @libriant/db-control prisma:migrate:deploy",
    "db:seed": "pnpm --filter @libriant/db-control seed",
    "dr:drill": "bash scripts/dr-drill.sh",
    "ingest:help": "tsx scripts/ingest-help-articles.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "db:studio": "pnpm --filter @libriant/db-control prisma:studio",
    "db:reset": "pnpm --filter @libriant/db-control prisma:migrate:reset",
    "tenant:migrate:deploy": "pnpm --filter @libriant/db-tenant prisma:migrate:deploy",
    "tenant:seed:defaults": "pnpm --filter @libriant/db-tenant seed:defaults",
    "tenant:smoke": "pnpm --filter @libriant/db-tenant smoke",
    "tenant:create": "tsx scripts/tenant-create.ts",
    "tenant:migrate": "tsx scripts/tenant-migrate.ts",
    "tenant:online": "tsx scripts/tenant-online.ts",
    "seed:v1-fixture": "tsx scripts/seed-v1-fixture.ts",
    "tenant:relocate": "tsx scripts/tenant-relocate.ts",
    "tenant:rotate-db-creds": "tsx scripts/tenant-rotate-db-creds.ts",
    "storage:migrate": "tsx scripts/storage-migrate.ts",
    "secrets": "tsx scripts/secrets.ts",
    "fleet:report": "tsx scripts/fleet-report.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "libphonenumber-js": "1.13.11",
    "marked": "^18.0.10",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
