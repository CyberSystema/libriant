# Libriant — production env template.
#
# Copy to `/srv/libriant/.env.prod` on the host (NOT into the deploy bundle
# — the workflow's rsync would overwrite it). Compose loads this file via
# the env-driven workflow; sourcing in a shell also works:
#   `set -a; source /srv/libriant/.env.prod; set +a`.

# --- hosts ---
PUBLIC_HOST=libriant.com
ADMIN_HOST=admin.libriant.com
ACME_EMAIL=ops@libriant.com

# Set to "true" to make Caddy serve the static maintenance page directly
# even when api + web are up. Belt-and-braces — system-mode in the DB is
# the normal lever.
MAINTENANCE_HARD=false

# --- images (GHCR) ---
# IMAGE_OWNER must be your GitHub owner/org in LOWERCASE — it's the namespace
# CI pushes to (ghcr.io/<owner>/libriant-api|web). The compose file pulls from
# the same path, so this must match or pulls 404.
IMAGE_OWNER=your-github-owner
# Set by the deploy workflow to the built commit SHA. Override to roll back.
IMAGE_TAG=latest

# --- postgres ---
POSTGRES_PASSWORD=please-rotate-me

# --- secrets ---
# All four MUST be set to long, random, distinct values. Generate fresh
# values with `openssl rand -hex 32` (or 64 for MFA_MASTER_KEY).
SESSION_SECRET=
ADMIN_SESSION_SECRET=
IMPERSONATION_SECRET=
# 64 hex chars (32 bytes) — AES-256-GCM master key for admin TOTP secrets.
MFA_MASTER_KEY=

STORAGE_SIGNING_SECRET=

# --- billing ---
# `fake` runs all billing flows with a built-in stand-in — no Stripe account,
# no charges (correct for a trial). Switch to `real` and fill the keys below
# once you have a Stripe account and want to take payments.
STRIPE_DRIVER=fake
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- email ---
# `console` logs outgoing mail to the container logs instead of sending it —
# nothing leaves the server, no mail provider needed (correct for a trial).
# Switch to `smtp` and set SMTP_URL (e.g. from Resend/Postmark/Brevo/SES) to
# actually deliver password resets, support codes, and notifications.
EMAIL_DRIVER=console
SMTP_URL=
# Optional. Defaults to "Libriant <no-reply@${PUBLIC_HOST}>".
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- backups ---
# Optional rclone destination. Leave blank to keep backups only on the
# host's local disk under /srv/libriant/backups.
RCLONE_REMOTE=
BACKUP_KEEP_DAYS=14
