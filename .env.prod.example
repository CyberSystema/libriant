# Libriant — production env template.
#
# You usually DON'T fill this in by hand. Run `scripts/ensure-env.sh` on the
# host and it generates every random secret below (and is re-run automatically
# on each deploy to fill anything missing — never overwriting existing values,
# so an initialised POSTGRES_PASSWORD is safe). You only supply IMAGE_OWNER,
# your domain, and the first admin login. This file documents every key.
#
# Lives at `/srv/libriant/.env.prod` on the host (NOT in the deploy bundle).
# Compose reads it via the deploy workflow; sourcing in a shell also works:
#   `set -a; source /srv/libriant/.env.prod; set +a`.

# --- hosts ---
PUBLIC_HOST=libriant.com
ADMIN_HOST=admin.libriant.com
ACME_EMAIL=ops@libriant.com

# Set to "true" to make Caddy serve the static maintenance page directly
# even when api + web are up. Belt-and-braces — system-mode in the DB is
# the normal lever.
MAINTENANCE_HARD=false

# --- images (GHCR) ---
# IMAGE_OWNER must be your GitHub owner/org in LOWERCASE — it's the namespace
# CI pushes to (ghcr.io/<owner>/libriant-api|web). The compose file pulls from
# the same path, so this must match or pulls 404.
IMAGE_OWNER=your-github-owner
# Set by the deploy workflow to the built commit SHA. Override to roll back.
IMAGE_TAG=latest

# --- postgres ---
# Leave blank — auto-generated on first run. Once Postgres has initialised with
# it, NEVER change it (the data volume is keyed to this password).
POSTGRES_PASSWORD=

# --- secrets ---
# Leave all blank — `scripts/ensure-env.sh` generates long random values
# (`openssl rand -hex 32`; 64 hex for MFA_MASTER_KEY) and won't overwrite them.
SESSION_SECRET=
ADMIN_SESSION_SECRET=
IMPERSONATION_SECRET=
# 64 hex chars (32 bytes) — AES-256-GCM master key for admin TOTP secrets.
MFA_MASTER_KEY=

STORAGE_SIGNING_SECRET=

# --- first admin (auto-created on deploy) ---
# Set these and the deploy creates the platform admin automatically (idempotent
# — skipped once it exists). You still enrol MFA in the browser on first login.
# Leave blank to skip auto-creation and run `pnpm admin:bootstrap` yourself.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- billing ---
# Master switch for plan/quota enforcement. `false` = the whole product is
# free: every tenant (library) gets unlimited access to all features, no plan
# limits, no upgrade prompts. The admin panel is unaffected. Set `true` (and
# STRIPE_DRIVER=real below) when you're ready to start subscriptions.
BILLING_ENABLED=false
# `fake` runs all billing flows with a built-in stand-in — no Stripe account,
# no charges (correct for a trial). Switch to `real` and fill the keys below
# once you have a Stripe account and want to take payments.
STRIPE_DRIVER=fake
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- email ---
# `console` logs outgoing mail to the container logs instead of sending it —
# nothing leaves the server, no mail provider needed (correct for a trial).
# To actually deliver password resets, support codes, and notifications, pick:
#   EMAIL_DRIVER=smtp    + SMTP_URL=...      (any SMTP relay, incl. Resend's)
#   EMAIL_DRIVER=resend  + RESEND_API_KEY=re_...   (Resend HTTP API)
# Either way the sending domain must be verified with the provider and match
# EMAIL_FROM, or sends are rejected.
EMAIL_DRIVER=console
SMTP_URL=
# Resend HTTP API key (re_...). Only used when EMAIL_DRIVER=resend.
RESEND_API_KEY=
# Optional. Defaults to "Libriant <no-reply@${PUBLIC_HOST}>".
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- desktop app ---
# Powers the in-panel desktop-app download (/t/<slug>/desktop). Installers are
# published to GitHub Releases under this repo by the `desktop-v*` workflow.
# Because the repo is PRIVATE, the API needs a token to list + stream the
# installer — WITHOUT IT THE DOWNLOAD 404s. Create a fine-grained PAT with
# `Contents: Read-only` on CyberSystema/libriant (or a classic `repo` token).
DESKTOP_RELEASE_REPO=CyberSystema/libriant
DESKTOP_RELEASE_TOKEN=

# --- backups ---
# Optional rclone destination. Leave blank to keep backups only on the
# host's local disk under /srv/libriant/backups.
RCLONE_REMOTE=
BACKUP_KEEP_DAYS=14
