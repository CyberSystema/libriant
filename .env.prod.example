# Libriant — production env template.
#
# You usually DON'T fill this in by hand. Run `scripts/ensure-env.sh` on the
# host and it generates every random secret below (and is re-run automatically
# on each deploy to fill anything missing — never overwriting existing values,
# so an initialised POSTGRES_PASSWORD is safe). You only supply IMAGE_OWNER,
# your domain, and the first admin login. This file documents every key.
#
# Lives at `/srv/libriant/.env.prod` on the host (NOT in the deploy bundle).
# Compose reads it via the deploy workflow; sourcing in a shell also works:
#   `set -a; source /srv/libriant/.env.prod; set +a`.

# --- hosts ---
# PUBLIC_HOST is the APP. SITE_HOST is the marketing site. PUBLIC_APEX_DOMAIN is
# the registrable domain both hang off, and is what tenant subdomains and the
# session cookie scope are derived from — it is NOT the same thing as the app
# host once they differ.
PUBLIC_HOST=app.libriant.com
SITE_HOST=libriant.com
PUBLIC_APEX_DOMAIN=libriant.com
ADMIN_HOST=admin.libriant.com
ACME_EMAIL=ops@libriant.com

# Set to "true" to make Caddy serve the static maintenance page directly
# even when api + web are up. Belt-and-braces — system-mode in the DB is
# the normal lever.
MAINTENANCE_HARD=false

# --- images (GHCR) ---
# IMAGE_OWNER must be your GitHub owner/org in LOWERCASE — it's the namespace
# CI pushes to (ghcr.io/<owner>/libriant-api|web). The compose file pulls from
# the same path, so this must match or pulls 404.
IMAGE_OWNER=your-github-owner
# Set by the deploy workflow to the built commit SHA. Override to roll back.
IMAGE_TAG=latest

# --- postgres ---
# Leave blank — auto-generated on first run. Once Postgres has initialised with
# it, NEVER change it (the data volume is keyed to this password).
POSTGRES_PASSWORD=

# --- secrets ---
# Leave all blank — `scripts/ensure-env.sh` generates long random values
# (`openssl rand -hex 32`; 64 hex for MFA_MASTER_KEY) and won't overwrite them.
SESSION_SECRET=
ADMIN_SESSION_SECRET=
IMPERSONATION_SECRET=
# 64 hex chars (32 bytes) — AES-256-GCM master key for admin TOTP secrets.
MFA_MASTER_KEY=

# Signs the tokens on `GET /_files/signed`, the one storage route with no guard
# at all — the token alone picks both the tenant and the object. It MUST NOT be
# a copy of SESSION_SECRET: one key covering both session forgery and anonymous
# cross-tenant file reads is exactly the oracle the separation prevents, so
# under NODE_ENV=production the API REFUSES TO BOOT when the two match:
#   Error: STORAGE_SIGNING_SECRET and SESSION_SECRET hold the same value —
#   refusing to boot. … Generate a distinct value (`openssl rand -hex 32`).
# `scripts/ensure-env.sh` generates the two independently, so this only bites a
# hand-edited file — and it bites as a container that will not start.
STORAGE_SIGNING_SECRET=

# --- first admin (auto-created on deploy) ---
# Set these and the deploy creates the platform admin automatically (idempotent
# — skipped once it exists). You still enrol MFA in the browser on first login.
# Leave blank to skip auto-creation and run `pnpm admin:bootstrap` yourself.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- billing ---
# Master switch for plan/quota enforcement. `false` = the whole product is
# free: every tenant (library) gets unlimited access to all features, no plan
# limits, no upgrade prompts. The admin panel is unaffected. Set `true` (and
# STRIPE_DRIVER=real below) when you're ready to start subscriptions.
BILLING_ENABLED=false
# Which Stripe implementation the API loads. Exactly two values are valid on a
# server:
#   none — NO Stripe driver at all. Every billing action refuses with a 503 and
#          POST /webhooks/stripe answers 503 without verifying anything. This is
#          the correct setting while you are not taking payments.
#   real — the Stripe API. Requires STRIPE_API_KEY + STRIPE_WEBHOOK_SECRET below.
# (A third value, `fake`, runs an in-memory stand-in. It is for development and
# the test suite ONLY: it accepts webhooks signed with a secret published in the
# Libriant repository, and POST /webhooks/stripe is unauthenticated by design —
# so on a server it would let anyone on the internet rewrite any library's
# subscription. The API refuses to load it outside NODE_ENV=development/test and
# falls back to `none`.)
STRIPE_DRIVER=none
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- email ---
# `console` logs outgoing mail to the container logs instead of sending it —
# nothing leaves the server, no mail provider needed (correct for a trial).
# To actually deliver password resets, support codes, and notifications, pick:
#   EMAIL_DRIVER=smtp    + SMTP_URL=...      (any SMTP relay, incl. Resend's)
#   EMAIL_DRIVER=resend  + RESEND_API_KEY=re_...   (Resend HTTP API)
# Either way the sending domain must be verified with the provider and match
# EMAIL_FROM, or sends are rejected.
EMAIL_DRIVER=console
SMTP_URL=
# Resend HTTP API key (re_...). Only used when EMAIL_DRIVER=resend.
RESEND_API_KEY=
# Optional. Defaults to "Libriant <no-reply@${PUBLIC_HOST}>".
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- desktop app ---
# Powers the in-panel desktop-app download (/t/<slug>/desktop). Installers are
# published to GitHub Releases under this repo by the `desktop-v*` workflow.
# Because the repo is PRIVATE, the API needs a token to list + stream the
# installer — WITHOUT IT THE DOWNLOAD 404s. Create a fine-grained PAT with
# `Contents: Read-only` on CyberSystema/libriant (or a classic `repo` token).
DESKTOP_RELEASE_REPO=CyberSystema/libriant
DESKTOP_RELEASE_TOKEN=

# --- backups ---
# Optional rclone destination. Leave blank to keep backups only on the
# host's local disk under /srv/libriant/backups.
RCLONE_REMOTE=
BACKUP_KEEP_DAYS=14

# --- database and cache limits (all optional; the defaults below are applied) ---
# performance-14. Postgres runs with a server-level statement_timeout so one
# runaway tenant query cannot hold a pool slot indefinitely. 60s because the
# longest legitimate single statement in the product is the export worker's,
# whose author already picked 60s as the line between slow and broken.
# pg_dump/pg_restore exempt themselves (the dump prologue sets both to 0), and a
# migration expected to run long must open with `SET statement_timeout = 0;`.
# Raise this for a maintenance window rather than removing it.
PG_STATEMENT_TIMEOUT=60s
PG_IDLE_TX_TIMEOUT=120s

# reliability-18. Redis had a 512 MB cgroup ceiling and no maxmemory, so it grew
# until the kernel OOM-killed it — a full outage rather than an eviction. Keep
# this BELOW REDIS_MEM_LIMIT with headroom; the two byte thresholds in
# infra/monitoring/alerts.yml are derived from it and must move with it.
REDIS_MAXMEMORY=384mb

# --- retention (performance-07 / privacy-legal-05) ---
# The retention sweep is written, registered and runs nightly, but every limb is
# OFF until you set a number here. That is deliberate: how long Libriant keeps
# each of these is a decision for the Privacy Policy §6 table, not for an
# engineer — but it does mean that in the shipped configuration the control
# database grows forever, so these are not optional so much as unanswered.
#
# Each has a floor the job refuses to go below (it logs and skips rather than
# enforcing a value that would delete something still needed). Leave blank to
# keep the current behaviour: no deletion at all.
CONTROL_AUDIT_RETENTION_DAYS=
EMAIL_OUTBOX_BODY_RETENTION_DAYS=
STRIPE_PAYLOAD_RETENTION_DAYS=
SUPPORT_ATTEMPT_RETENTION_DAYS=
APPLICATION_RETENTION_MONTHS=
