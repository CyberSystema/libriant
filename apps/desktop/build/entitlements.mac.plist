<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron/V8 needs JIT under hardened runtime. `allow-jit` is mandatory.
       `allow-unsigned-executable-memory` is kept because dropping it still
       crashes V8 on several macOS versions; re-test removing it on the first
       real notarized build. (A11-04) -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- A11-04: `com.apple.security.cs.disable-library-validation` was REMOVED.
       The app bundles no native/third-party native modules (npmRebuild:false),
       so every loaded library is signed with the app's own Developer ID and
       library validation can stay ON. Re-add ONLY if a future native dependency
       (signed by a different team) fails to load under notarization. -->
  <!-- A11-04: `com.apple.security.device.audio-input` was REMOVED — the app
       uses the camera for barcode scanning only and never records audio (see
       NSMicrophoneUsageDescription "not used"). -->
  <!-- MANDATORY for the web barcode scanner (getUserMedia) to work once the
       app is notarized under hardened runtime. Without this the camera is
       silently blocked. Paired with NSCameraUsageDescription in extendInfo. -->
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
