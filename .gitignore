.pnpm-store/
dist/
build/
.next/
.turbo/
coverage/
.env
.env.local
.env.*.local
# Production secrets file (the secrets-manager's default target if run in-repo)
# + the atomic-write temp files it creates. NOT .env.prod.example, which is a
# tracked template (exact-match rule below leaves it alone).
.env.prod
.env*.tmp-*
*.log
.DS_Store
.vscode/
.idea/
*.tsbuildinfo
.cache/
# Runtime upload storage (STORAGE_ROOT) — never the API's storage *source*
# module. The broad match below otherwise swallows apps/api/src/storage/,
# which left the whole module untracked and broke CI + image builds.
storage/
!apps/api/src/storage/
!apps/api/src/storage/**
.dev-storage/
prisma/generated/

